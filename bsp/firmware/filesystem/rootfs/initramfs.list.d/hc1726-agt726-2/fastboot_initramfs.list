/bin/busybox
/bin/cat
/bin/mount
/bin/sh
/bin/umount
/bin/grep
/bin/sleep
/bin/rm
/usr/bin/awk
/sbin/halt
/sbin/switch_root

# library
/lib/libuClibc-*
/lib/ld-*
/lib/libc.*
/lib/libgcc_s.so.1

# fastboot
/sbin/modprobe
/etc/fastboot_video
/system/bin/mpi_stream
/system/mpp/case_config/case_config_1003
/system/mpp/case_config/case_config_1004_FHD
/system/mpp/case_config/DFN203-1
