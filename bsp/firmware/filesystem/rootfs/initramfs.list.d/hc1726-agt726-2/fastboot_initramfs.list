# modprobe
/etc/modprobe.d/mpp.conf

# early audio
/usr/lib/libasound*
/usr/share/alsa/*
/usr/share/alsa/cards/*
/usr/share/alsa/ctl/*
/usr/share/alsa/pcm/*
/etc/asound.conf

#fw_printenv
