##!/bin/sh
### BEGIN INIT INFO
# Provides:          zram
# Required-Start:    $local_fs
# Default-Start:     2 3 4 5
# Short-Description: Enable compressed zram swap
### END INIT INFO

ZRAM_DEV="/dev/zram0"
DEFAULT_ZRAM_SIZE="4M"      # 未提供 product 設定時的預設值，建壓縮前大小，建議約 50% RAM 
ZRAM_SIZE="$DEFAULT_ZRAM_SIZE"
COMP_ALG="lz4"              # 壓縮演算法

# Product-specific settings are provided through
# rootfs/add.list.d/<product>/assets.
# A reboot is required for changes to /etc/zram_size.conf to take effect.
CONFIG_FILE="/etc/zram_size.conf"


if [ -r "$CONFIG_FILE" ]; then
    CONFIG_ZRAM_SIZE=$(awk -F'"' '
        /^ZRAM_SIZE="/ {
            value = $2
            if (value ~ /^[0-9]+[KMG]$/)
                print value
            exit
        }
    ' "$CONFIG_FILE")

    if [ -n "$CONFIG_ZRAM_SIZE" ]; then
        ZRAM_SIZE="$CONFIG_ZRAM_SIZE"
    else
        echo "Warning: invalid ZRAM_SIZE in $CONFIG_FILE; use default $DEFAULT_ZRAM_SIZE"
    fi
fi



case "$1" in
  start)
    echo "Initializing ZRAM compressed swap..."
    modprobe zram || true
    [ ! -e "$ZRAM_DEV" ] && echo "Error: $ZRAM_DEV not found." && exit 1

    echo $COMP_ALG > /sys/block/zram0/comp_algorithm
    echo $ZRAM_SIZE > /sys/block/zram0/disksize

    echo 256 > /proc/sys/vm/min_free_kbytes
    echo 1 > /proc/sys/vm/compact_unevictable_allowed
    echo 500 > /proc/sys/vm/extfrag_threshold

    mkswap $ZRAM_DEV
    swapon $ZRAM_DEV

    echo "ZRAM swap enabled ($ZRAM_SIZE, $COMP_ALG)"
    ;;
  stop)
    echo "Stopping zram swap..."
    swapoff $ZRAM_DEV 2>/dev/null || true
    echo 1 > /sys/class/zram-control/hot_remove 2>/dev/null || true
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0

