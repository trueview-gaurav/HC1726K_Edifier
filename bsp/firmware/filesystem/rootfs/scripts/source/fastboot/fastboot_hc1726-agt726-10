do_start() {
	busybox modprobe otp_ep
	busybox modprobe mpp.ko

    /system/bin/mpi_stream -d /system/mpp/case_config/case_config_1004 \
    -ppool_idx=0 -pblock_cnt=3 -pblock_size=327698 -ppool_name=isp_TMV_0 \
    -pdev_idx=0 -pinput_fps=25.0 -pinput_res=2592x1944 \
    -pchn_idx=0 -poutput_res=2592x1944 -poutput_fps=15 -pwindow_fps=15 \
    -penc_idx=0 -penc_res=2592x1944 -pmax_enc_res=2592x1944 \
    -pgop_size=15 -penc_fps=15 -prc_mode=VBR -pmax_bit_rate=4096 -pvenc_type=H265 \
    -pchn_idx=1 -poutput_res=1280x720 -poutput_fps=15 -pwindow_fps=15 \
    -penc_idx=1 -penc_res=1280x720 -pmax_enc_res=1280x720 \
    -pgop_size=15 -penc_fps=15 -prc_mode=VBR -pmax_bit_rate=512 -pvenc_type=H265 \
    > /dev/null &



	busybox modprobe audio_pcm.ko
	busybox modprobe audio_machine.ko

}

case "$1" in
	start)
		do_start
		;;
	restart)
		;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
esac
