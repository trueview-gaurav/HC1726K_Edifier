do_start() {
	busybox modprobe otp_ep
	busybox modprobe mpp.ko
	/system/bin/mpi_stream -d /system/mpp/case_config/case_config_1001 -pinput_fps=30 -poutput_fps=30 -pwindow_fps=30 -penc_fps=30 > /dev/null &
	busybox modprobe audio_pcm.ko
	busybox modprobe audio_machine.ko
}



case "$1" in
	start)
		do_start
		;;
	restart)
		;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
esac
