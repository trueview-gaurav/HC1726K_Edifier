do_start() {
	busybox modprobe otp_ep
	busybox modprobe mpp.ko

	/system/bin/mpi_stream -d /system/mpp/case_config/case_config_1004_FHD \
	-pdev_idx=0 -pbayer=PHASE_G0 -pinput_fps=15.0 -pinput_res=1920x1080 \
	-ppath_idx=0 -pmax_adv_isp_fps=8 \
	-pchn_idx=0 -poutput_res=1920x1080 -poutput_fps=15 -pwindow_fps=15 \
	-pchn_idx=1 -poutput_res=640x360 -poutput_fps=15 -pwindow_fps=15 \
	-penc_idx=0 -penc_res=1920x1080 -pmax_enc_res=1920x1080 \
	-penc_fps=15 -pmax_bit_rate=2048 \
	-penc_idx=1 -penc_res=640x360 -pmax_enc_res=640x360 \
	-penc_fps=15 -pmax_bit_rate=2048 \
    > /dev/null &

	busybox modprobe audio_pcm.ko
	busybox modprobe audio_machine.ko
}

case "$1" in
	start)
		do_start
		;;
	restart)
		;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
esac
