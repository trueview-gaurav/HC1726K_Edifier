#!/bin/sh
#
# Start/stop tuya Service
#
# Pairing Mode: 0 = AUTO (qrCode/wifi monitor).
# Pairing Mode: 1 = WIFI AP Mode.
# Pairing Mode: 2 = DEBUG MODE
PAIR_MODE=1
TUYA_BIN=/system/bin/tuya_service

# Access mode
MODE=/system/bin/mode
# Production tool flag
run_prod_tool="/mnt/sdcard/RunProductionTool"

do_start() {
	/sbin/sysctl -w net.core.rmem_default=524288
	/sbin/sysctl -w net.core.wmem_default=524288
	/sbin/sysctl -w net.core.rmem_max=624288
	/sbin/sysctl -w net.core.wmem_max=724288
	$TUYA_BIN -m $PAIR_MODE &
}

do_stop() {
    killall -2 tuya_service
}


case "$1" in
  start)
	mode=$($MODE)
	# Production tool
	if [ -f $run_prod_tool ] && [ $mode == "user" ]; then
		echo " - Skip Tuya service..."
		return 0
	fi

	echo "Starting tuya_service [AP mode]"
    do_start
	;;
  stop)
	echo "Stop tuya_service [AP mode]"
    do_stop
	;;
  restart|reload)
    do_stop
    do_start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
