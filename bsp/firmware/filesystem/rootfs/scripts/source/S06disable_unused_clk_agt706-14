#!/bin/sh

#EFUSE/EIRQ [1]
#devmem 0x80000014 32 0
#TIMER 0~3 [3:0]
devmem 0x80000018 32 0
#TRNG [0] [2:0]
devmem 0x8000001C 32 0
#I2C 0~2
# turn off I2C 2
devmem 0x80000020 32 0x3
#SPI 0~1 / SPI_SLAVE [2:0]
devmem 0x80000024 32 0
#PWM 0~6 [6:0]
# turn off PWM 0, 2, 4, 5, 6
devmem 0x80000028 32 0xA
#UART 0~2
# turn off UART 2
devmem 0x8000002C 32 0x3
#PVT // no need
devmem 0x800000D4 32 0
#SDC 0~1 [8, 0]
# turn off SDC 1
devmem 0x80000034 32 0x1
#EMAC [0]
#devmem 0x80000038 32 0
#USB [8, 0]
#devmem 0x8000003C 32 0x101
#MIPI_CHOP0 // no need
devmem 0x80000044 32 0
#SAADC
devmem 0x80000054 32 0x1F
#USB_FM // no need
devmem 0x80000058 32 0
