software =
{
	version = "SYSUPD_VERSION";
	description = "Augentix system update";

	/* hardware-compatibility is not set */
	/* partitions are not set */
	release: {
		copy_1: {
			images: (
				{
					filename = "KERNEL_BIN";
					device = "/dev/mmcblk0p3";
					type = "raw";
					sha256 = "KERNEL_SHA";
				},
				{
					filename = "ROOTFS_BIN";
					device = "/dev/mmcblk0p5";
					type = "raw";
					sha256 = "ROOTFS_SHA";
				}
			);
			scripts: (
				{
					filename = "pre-install.sh";
					type = "preinstall";
					sha256 = "PRE_INSTALL_SHA";
				},
				{
					filename = "post-install.sh";
					type = "postinstall";
					sha256 = "POST_INSTALL_SHA";
				}
			);
		};
		copy_2: {
			images: (
				{
					filename = "KERNEL_BIN";
					device = "/dev/mmcblk0p4";
					type = "raw";
					sha256 = "KERNEL_SHA";
				},
				{
					filename = "ROOTFS_BIN";
					device = "/dev/mmcblk0p6";
					type = "raw";
					sha256 = "ROOTFS_SHA";
				}
			);
			scripts: (
				{
					filename = "pre-install.sh";
					type = "preinstall";
					sha256 = "PRE_INSTALL_SHA";
				},
				{
					filename = "post-install.sh";
					type = "postinstall";
					sha256 = "POST_INSTALL_SHA";
				}
			);
		};
	};
}
