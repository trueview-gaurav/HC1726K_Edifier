#CONFIG_HC1702_1752_1772_1782 is not set
#CONFIG_HC1703_1723_1753_1783S is not set
CONFIG_SAPPORO=y
#CONFIG_DUAL_OS is not set
CONFIG_UCLIBC=y

CONFIG_CHIP=HC1706H
CONFIG_MACH=hc1706h-agt706-11
CONFIG_PROD_AGT706_11=y
CONFIG_TARGET_CPU=cortex-a7
CONFIG_NVSP_LAYOUT="hc1706h-agt706-11.ini"
SENSOR=GC2083
SENSOR1=
LENS=YT0X7X61-A-HD+IR0764_CPSID100740
MOTHERBOARD=MB033
AUDIO_CODEC=adc


# Buildroot
BUILDROOT_DEFCONFIG=arm-augentix-linux-uclibcgnueabihf_defconfig

# Applications
APP_CONFIG=hc1706h-agt706-11_defconfig

# Sample demo
SAMPLE_DEMO_CONFIG=hc1706h-agt706-11_defconfig

# Sample tee demo
SAMPLE_OPTEE_CONFIG=hc1706h-agt706-11_defconfig

# Remote
REMOTE_CONFIG=hc1706h-agt706-11_defconfig

# AMPC
AMPC_CONFIG=hc1706h-agt706-11_defconfig

# Kernel
KERNEL_CONFIG=hc1706h-agt706-11_defconfig
#CONFIG_KERNEL_V6_1=y
CONFIG_UIMAGE_LOADADDR=0x01000000
# uimage compression support none, gzip, bzip2, lzma, lzo, lz4
CONFIG_UIMAGE_COMPRESS=none
#CONFIG_UIMAGE_DECOMPRESS_ADDR=0x00200000

# TEE
OPTEE_CONFIG=hc1706h-agt706-11_defconfig

# Audio
#CONFIG_AUDIO_DMIC_READY_DELAY is not set

# U-Boot
UBOOT_CONFIG=hc1706h-agt706-11_defconfig

# Rootfs
ROOTFS_LOADADDR=0x01100000

# DTS
DTB_NAME=hc1706h-agt706-11.dtb

# Pintctrl static setting
PINCTRL_HEADER=hc1706h-agt706-11.h

# DRAM configuration
CONFIG_DDR_TYPE_DDR2=y
# CONFIG_DDR_TYPE_DDR3 is not set
CONFIG_DRAM_CAPACITY=64

CONFIG_DRAM_GENERIC_DDR2=y
# CONFIG_DRAM_GENERIC_DDR3L is not set

# DRAM frequency
# CONFIG_DRAM_MTS_1700 is not set
#CONFIG_DRAM_MTS_1333 is not set
CONFIG_DRAM_MTS_1200=y

# Thermal protection
#CONFIG_THERMAL_PROTECTION_SUPPORT is not set
#CONFIG_THERMAL_PROTECTION_INFO_FROM_ADC is not set
#CONFIG_THERMAL_PROTECTION_ADC_CHANNEL is not set
#CONFIG_THERMAL_PROTECTION_ADC_FORMULA_MULTIPLE is not set
#CONFIG_THERMAL_PROTECTION_ADC_FORMULA_DIVIDE is not set
#CONFIG_THERMAL_PROTECTION_ADC_FORMULA_OFFSET is not set
#CONFIG_THERMAL_PROTECTION_INFO_FROM_SENSOR is not set
#CONFIG_THERMAL_PROTECTION_I2C_CHIP is not set
#CONFIG_THERMAL_PROTECTION_I2C_DEV is not set
#CONFIG_THERMAL_PROTECTION_IIR_COEFFICIENT is not set
#CONFIG_THERMAL_PROTECTION_THRESHOLD_MEDIUM is not set
#CONFIG_THERMAL_PROTECTION_THRESHOLD_HIGH is not set
#CONFIG_THERMAL_PROTECTION_SAMPLE_RATE_MS is not set

# FLASH TYPE
CONFIG_FLASH_NOR=y
#CONFIG_FLASH_NAND is not set

# NAND-specific UBI/UBIFS settings
CONFIG_UBI_PEBSIZE=0x20000
CONFIG_UBI_SUBSIZE=0
CONFIG_UBIFS_LEBSIZE=0x1f000
CONFIG_UBIFS_MINIOSIZE=0x800
CONFIG_ROOTFS_SQUASHFS=y
# Squashfs over UBI is required for NAND products using Squashfs
# CONFIG_ROOTFS_SQUASHFS_OVER_UBI is not set
CONFIG_ROOTFS_SQUASHFS_XZ=y
CONFIG_USRDATA_JFFS2=y
CONFIG_USRDATA_UBIFS_MAXLEBCNT=850
CONFIG_USRDATA_UBIFS_JRNLSIZE=0xC0000
CONFIG_CALIB_UBIFS_MAXLEBCNT=32
CONFIG_CALIB_UBIFS_JRNLSIZE=0x73a0

# Fast boot
CONFIG_FASTBOOT=y
