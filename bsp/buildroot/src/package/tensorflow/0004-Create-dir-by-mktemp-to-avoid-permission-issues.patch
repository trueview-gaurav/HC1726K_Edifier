From 2037c8c6fb2b33efb8bbecbbb6247c2861bfd18d Mon Sep 17 00:00:00 2001
From: "Edward.Lee im105" <edward.lee@augentix.com>
Date: Thu, 16 Sep 2021 17:36:15 +0800
Subject: [PATCH 4/8] Create dir by mktemp to avoid permission issues

---
 .../lite/micro/tools/make/ext_libs/cmsis_download.sh | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/tensorflow/lite/micro/tools/make/ext_libs/cmsis_download.sh b/tensorflow/lite/micro/tools/make/ext_libs/cmsis_download.sh
index 9c6dba85..9a4a1b76 100755
--- a/tensorflow/lite/micro/tools/make/ext_libs/cmsis_download.sh
+++ b/tensorflow/lite/micro/tools/make/ext_libs/cmsis_download.sh
@@ -53,13 +53,17 @@ else
   CMSIS_URL="http://github.com/ARM-software/CMSIS_5/archive/${ZIP_PREFIX}.zip"
   CMSIS_MD5="53e28e6613d88ed0830b0534bdc27893"
 
+  TMP_PATTERN=$(mktemp XXXXXXXXXX -u)
+
   # wget is much faster than git clone of the entire repo. So we wget a specific
   # version and can then apply a patch, as needed.
-  wget ${CMSIS_URL} -O /tmp/${ZIP_PREFIX}.zip >&2
-  check_md5 /tmp/${ZIP_PREFIX}.zip ${CMSIS_MD5}
+  wget ${CMSIS_URL} -O /tmp/${ZIP_PREFIX}.zip.${TMP_PATTERN} >&2
+  check_md5 /tmp/${ZIP_PREFIX}.zip.${TMP_PATTERN} ${CMSIS_MD5}
 
-  unzip -qo /tmp/${ZIP_PREFIX}.zip -d /tmp >&2
-  mv /tmp/CMSIS_5-${ZIP_PREFIX} ${DOWNLOADED_CMSIS_PATH}
+  mkdir /tmp/cmsis_5.${TMP_PATTERN}
+  unzip -qo /tmp/${ZIP_PREFIX}.zip.${TMP_PATTERN} -d /tmp/cmsis_5.${TMP_PATTERN} >&2
+  mv /tmp/cmsis_5.${TMP_PATTERN}/CMSIS_5-${ZIP_PREFIX} ${DOWNLOADED_CMSIS_PATH}
+  rmdir /tmp/cmsis_5.${TMP_PATTERN}
 fi
 
 echo "SUCCESS"
