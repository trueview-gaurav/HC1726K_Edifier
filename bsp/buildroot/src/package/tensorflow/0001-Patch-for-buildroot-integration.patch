+.PHONY: all
+
+# Create rules for downloading third-party dependencies.
+THIRD_PARTY_TARGETS :=
+$(foreach DOWNLOAD,$(THIRD_PARTY_DOWNLOADS),$(eval $(call create_download_rule,$(DOWNLOAD))))
+third_party_downloads: $(THIRD_PARTY_TARGETS)
+
+MICROLITE_LIB_OBJS := $(addprefix $(OBJDIR)/, \
+$(patsubst %.cc,%.o,$(patsubst %.c,%.o,$(MICROLITE_CC_SRCS))))
+
+MICROLITE_LIB_OBJS += $(addprefix $(OBJDIR)/, \
+$(patsubst %.S,%.o,$(patsubst %.cc,%.o,$(patsubst %.c,%.o,$(THIRD_PARTY_CC_SRCS)))))
+
+# For normal manually-created TensorFlow C++ source files.
+$(OBJDIR)/%.o: %.cc $(THIRD_PARTY_TARGETS)
+	@mkdir -p $(dir $@)
+	$(Q)$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@
+
+# For normal manually-created TensorFlow C source files.
+$(OBJDIR)/%.o: %.c $(THIRD_PARTY_TARGETS)
+	@mkdir -p $(dir $@)
+	$(Q)$(CC)  $(CCFLAGS) $(INCLUDES) -c $< -o $@
+
+# For normal manually-created TensorFlow ASM source files.
+$(OBJDIR)/%.o: %.S $(THIRD_PARTY_TARGETS)
+	@mkdir -p $(dir $@)
+	$(Q)$(CC) $(CCFLAGS) $(INCLUDES) -c $< -o $@
+
+dest: $(LIBDIR)
+$(LIBDIR):
+	$(Q)mkdir -p $(LIBDIR)
+
+TARGET_VERSION_FILE := $(PREFIX)/include/$(root)/tensorflow/lite/micro/micro_interpreter.h
+VERSION := $(shell grep TFLITE_SCHEMA_VERSION -r $(root)/tensorflow/lite/version.h | grep -o '[0-9]*')
+
+.PHONY: version
+version: remove-version $(TARGET_HEADERS)
+	$(shell sed -i "/^namespace\ tflite/i \#define\ TFLITE_SCHEMA_VERSION \($(VERSION)\)\\n" $(TARGET_VERSION_FILE))
+
+remove-version:
+	$(Q)rm -f $(TARGET_HEADERS)
+
+install-header : $(TARGET_HEADERS) $(TARGET_3RD_HDRS)
+
+$(PREFIX)/include/% : %
+	@mkdir -p $(basename $@)
+	$(Q)install -m 666 $< $@
+
+$(PREFIX)/include/% : $(MICRO_3RD_INC_ROOT)/%
+	@mkdir -p $(basename $@)
+	$(Q)install -m 666 $< $@
+
+$(PREFIX)/include/% : $(MICRO_3RD_INC_ROOT)/flatbuffers/include/%
+	@mkdir -p $(basename $@)
+	$(Q)install -m 666 $< $@
+
+uninstall-header:
+	$(Q)rm -rf $(TARGET_HEADERS) $(TARGET_3RD_HDRS)
+
+# The target that's compiled if there's no command-line arguments.
+all: $(LIBDIR) lib
+
+microlite: $(LIBDIR) lib
+
+lib: $(MICROLITE_SLIB_PATH) $(MICROLITE_DLIB_PATH)
+
+# Hack for generating schema file bypassing flatbuffer parsing
+$(root)/tensorflow/lite/schema/schema_generated.h:
+	@cp -u $(root)/tensorflow/lite/schema/schema_generated.h.oss $(root)/tensorflow/lite/schema/schema_generated.h
+
+# Gathers together all the objects we've compiled into a single '.a' archive.
+$(MICROLITE_SLIB_PATH): $(root)/tensorflow/lite/schema/schema_generated.h $(MICROLITE_LIB_OBJS)
+	@mkdir -p $(dir $@)
+	$(Q)$(AR) $(ARFLAGS) $(MICROLITE_SLIB_PATH) $(MICROLITE_LIB_OBJS)
+
+$(MICROLITE_DLIB_PATH): $(MICROLITE_LIB_OBJS)
+	@mkdir -p $(dir $@)
+	$(Q)$(CXX) -shared -Wl,--build-id -Wl,--soname,$(MICROLITE_DLIB_NAME) -o $@ $^
+	ln -sfn $@ $(LIBDIR)/$(MICROLITE_DLIB_NAME_RAW)
+	cd $(LIBDIR) && ln -sf $(MICROLITE_DLIB_NAME) $(MICROLITE_DLIB_NAME_RAW) && cd -
+
+$(BINDIR)/%_test : $(OBJDIR)%_test.o $(MICROLITE_LIB_PATH)
+	@mkdir -p $(dir $@)
+	$(CXX) $(CXXFLAGS) $(INCLUDES) \
+	-o $@ $< \
+	$(MICROLITE_LIB_PATH) $(LDFLAGS) $(MICROLITE_LIBS)
+
+$(BINDIR)/%.test_target: $(BINDIR)/%_test
+	@test -f $(TEST_SCRIPT) || (echo 'Unable to find the test script. Is the software emulation available in $(TARGET)?'; exit 1)
