diff --git a/Makefile.lite b/Makefile.lite
new file mode 100644
index 00000000..f6c391e5
--- /dev/null
+++ b/Makefile.lite
@@ -0,0 +1,473 @@
+# Make uses /bin/sh by default, which is incompatible with the bashisms seen
+# below.
+# include Makefile.tmp
+SHELL   := /bin/bash
+root = $(realpath $(CURDIR))
+TF_PATH =$(root)
+TF_VERSION_PATH = $(root)/tensorflow/core/public/version.h
+TF_LITE =$(TF_PATH)/tensorflow/lite
+MAKEFILE_DIR =$(TF_LITE)/tools/make
+TF_VERSION_STRING?=.2.6.0
+PREFIX  ?= $(TFLITE_BUILD_PREFIX)
+# Link error to minimal.cc using micro BUILD_TYPE
+# BUILD_TYPE ?= micro
+BUILD_TYPE ?=
+TFLITE_HAVE_CPUINFO ?= false
+V ?= 0
+ifeq ($(V), 1)
+Q=
+else
+Q=@
+endif
+MAKEFLAGS=-j $(shell grep -c ^processor /proc/cpuinfo)
+
+# Override these on the make command line to target a specific architecture. For example:
+# make -f tensorflow/lite/tools/make/Makefile TARGET=rpi TARGET_ARCH=armv7l
+INCLUDES := \
+-I$(TF_PATH) \
+-I$(MAKEFILE_DIR)/downloads/ \
+-I$(MAKEFILE_DIR)/downloads/eigen \
+-I$(MAKEFILE_DIR)/downloads/absl \
+-I$(MAKEFILE_DIR)/downloads/gemmlowp \
+-I$(MAKEFILE_DIR)/downloads/ruy \
+-I$(MAKEFILE_DIR)/downloads/neon_2_sse \
+-I$(MAKEFILE_DIR)/downloads/farmhash/src \
+-I$(MAKEFILE_DIR)/downloads/flatbuffers/include \
+-I$(MAKEFILE_DIR)/downloads/fp16/include \
+-I$(MAKEFILE_DIR)/downloads/cpuinfo \
+-I$(MAKEFILE_DIR)/downloads/cpuinfo/include \
+-I$(MAKEFILE_DIR)/downloads/cpuinfo/src \
+-I$(MAKEFILE_DIR)/downloads/cpuinfo/deps/clog/include
+#-I$(OBJDIR)
+# This is at the end so any globally-installed frameworks like protobuf don't
+# override local versions in the source tree.
+#INCLUDES += -I/usr/local/include
+
+LITE_INCLUDES := $(shell find $(TF_LITE) -maxdepth 3 \( -name '*.h' -o -name '*.hh' \) )
+ABSL_INCLUDES := $(shell find $(MAKEFILE_DIR)/downloads/absl/ \( -name '*.h' -o -name '*.hh' \) )
+FLATBUFFERS_INCLUDES := $(shell find $(MAKEFILE_DIR)/downloads/flatbuffers/include/ -maxdepth 2 \( -name '*.h' -o -name '*.hh' \) )
+
+# These are the default libraries needed, but they can be added to or
+# overridden by the platform-specific settings in target makefiles.
+
+# There are no rules for compiling objects for the host system (since we don't
+# generate things like the protobuf compiler that require that), so all of
+# these settings are for the target compiler.
+DEBUG ?=0
+DEBUG_FLAGS =
+ifeq ($(DEBUG),1)
+DEBUG_FLAGS += -g -O0
+else
+DEBUG_FLAGS += -O3 -DNDEBUG -DCPU_SETSIZE=__CPU_SETSIZE
+endif
+
+CC_COMMON_FLAGS ?= $(TENSORFLOW_COMMON_FLAGS) $(DEBUG_FLAGS)
+CFLAGS = $(CC_COMMON_FLAGS) -std=gnu99
+CXXFLAGS = $(CC_COMMON_FLAGS) -std=c++11
+LIBS ?= $(TENSORFLOW_LD_FLAGS)
+
+LDOPTS := -L/usr/local/lib
+ARFLAGS := -r
+TARGET_TOOLCHAIN_PREFIX ?= $(TENSORFLOW_TOOLCHAIN_PREFIX)
+CC_PREFIX :=
+
+# This library is the main target for this makefile. It will contain a minimal
+# runtime that can be linked in to other programs.
+SLIB_NAME := libtensorflow-lite.a
+DLIB_NAME_RAW := libtensorflow-lite.so
+DLIB_NAME := $(DLIB_NAME_RAW)$(TF_VERSION_STRING)
+
+# Benchmark static library and binary
+BENCHMARK_LIB_NAME := benchmark-lib.a
+BENCHMARK_BINARY_NAME := benchmark_model
+BENCHMARK_PERF_OPTIONS_BINARY_NAME := benchmark_model_performance_options
+
+# What sources we want to compile, must be kept in sync with the main Bazel
+# build files.
+
+PROFILER_SRCS := \
+	$(root)/tensorflow/lite/profiling/memory_info.cc \
+	$(root)/tensorflow/lite/profiling/platform_profiler.cc \
+	$(root)/tensorflow/lite/profiling/time.cc
+
+PROFILE_SUMMARIZER_SRCS := \
+	$(root)/tensorflow/lite/profiling/profile_summarizer.cc \
+	$(root)/tensorflow/lite/profiling/profile_summary_formatter.cc \
+	$(root)/tensorflow/core/util/stats_calculator.cc
+
+CMD_LINE_TOOLS_SRCS := \
+	$(root)/tensorflow/lite/tools/command_line_flags.cc \
+	$(root)/tensorflow/lite/tools/tool_params.cc
+
+CORE_CC_ALL_SRCS := \
+$(wildcard $(root)/tensorflow/lite/*.cc) \
+$(wildcard $(root)/tensorflow/lite/*.c) \
+$(wildcard $(root)/tensorflow/lite/c/*.c) \
+$(wildcard $(root)/tensorflow/lite/c/*.cc) \
+$(wildcard $(root)/tensorflow/lite/core/*.cc) \
+$(wildcard $(root)/tensorflow/lite/core/api/*.cc) \
+$(wildcard $(root)/tensorflow/lite/delegates/interpreter_utils.cc) \
+$(wildcard $(root)/tensorflow/lite/experimental/resource/*.cc) \
+$(wildcard $(root)/tensorflow/lite/schema/schema_conversion_utils.cc) \
+$(wildcard $(root)/tensorflow/lite/schema/schema_utils.cc) \
+$(wildcard $(root)/tensorflow/lite/tools/make/downloads/ruy/ruy/*.cc)
+ifeq ($(TFLITE_HAVE_CPUINFO),true)
+CORE_CC_ALL_SRCS += \
+$(wildcard $(root)/tensorflow/lite/tools/make/downloads/cpuinfo/src/*.c) \
+$(wildcard $(root)/tensorflow/lite/tools/make/downloads/cpuinfo/src/x86/*.c) \
+$(wildcard $(root)/tensorflow/lite/tools/make/downloads/cpuinfo/src/x86/linux/*.c) \
+$(wildcard $(root)/tensorflow/lite/tools/make/downloads/cpuinfo/src/x86/cache/*.c) \
+$(wildcard $(root)/tensorflow/lite/tools/make/downloads/cpuinfo/src/linux/*.c) \
+$(wildcard $(root)/tensorflow/lite/tools/make/downloads/cpuinfo/deps/clog/src/*.c)
+endif
+ifneq ($(BUILD_TYPE),micro)
+CORE_CC_ALL_SRCS += \
+$(wildcard $(root)/tensorflow/lite/kernels/*.cc) \
+$(wildcard $(root)/tensorflow/lite/kernels/internal/*.cc) \
+$(wildcard $(root)/tensorflow/lite/kernels/internal/optimized/*.cc) \
+$(wildcard $(root)/tensorflow/lite/kernels/internal/reference/*.cc) \
+$(wildcard $(root)/tensorflow/lite/tools/optimize/sparsity/*.cc) \
+$(PROFILER_SRCS) \
+$(root)/tensorflow/lite/tools/make/downloads/farmhash/src/farmhash.cc \
+$(root)/tensorflow/lite/tools/make/downloads/fft2d/fftsg.c \
+$(root)/tensorflow/lite/tools/make/downloads/fft2d/fftsg2d.c \
+$(root)/tensorflow/lite/tools/make/downloads/flatbuffers/src/util.cpp
+CORE_CC_ALL_SRCS += \
+	$(shell find tensorflow/lite/tools/make/downloads/absl/absl/ \
+	             -type f -name \*.cc | grep -v test | grep -v benchmark | grep -v synchronization | grep -v debugging | grep -v hash | grep -v flags | grep -v random)
+endif
+# Remove any duplicates.
+CORE_CC_ALL_SRCS := $(sort $(CORE_CC_ALL_SRCS))
+CORE_CC_EXCLUDE_SRCS := \
+$(wildcard $(root)/tensorflow/lite/*test.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*test.c) \
+$(wildcard $(root)/tensorflow/lite/*/*test.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*test*.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*_ops_wrapper.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*/benchmark.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*/example*.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*/test*.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*/*test.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*/*tool.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*/*/benchmark.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*/*/example*.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*/*/test*.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*/*/*test.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*/*/*tool.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*/*/*/*/benchmark.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*/*/*/*/example*.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*/*/*/*/test*.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*/*/*/*/*test.cc) \
+$(wildcard $(root)/tensorflow/lite/*/*/*/*/*/*tool.cc) \
+$(wildcard $(root)/tensorflow/lite/tools/make/downloads/cpuinfo/src/*/mock*.c) \
+$(root)/tensorflow/lite/create_op_resolver_with_selected_ops.cc \
+$(root)/tensorflow/lite/tflite_with_xnnpack.cc \
+$(MINIMAL_SRCS)
+
+BUILD_WITH_MMAP ?= true
+ifeq ($(BUILD_TYPE),micro)
+	BUILD_WITH_MMAP=false
+endif
+
+ifeq ($(BUILD_WITH_MMAP),true)
+	CORE_CC_EXCLUDE_SRCS += $(root)/tensorflow/lite/mmap_allocation_disabled.cc
+else
+	CORE_CC_EXCLUDE_SRCS += $(root)/tensorflow/lite/mmap_allocation.cc
+endif
+
+BUILD_WITH_RUY ?= false
+ifeq ($(TARGET_ARCH),aarch64)
+	BUILD_WITH_RUY=true
+endif
+ifeq ($(BUILD_WITH_RUY),true)
+  CXXFLAGS += -DTFLITE_WITH_RUY
+endif
+
+BUILD_WITH_RUY_PROFILER ?= false
+ifeq ($(BUILD_WITH_RUY_PROFILER),true)
+  CORE_CC_ALL_SRCS += $(root)/tensorflow/lite/tools/make/downloads/ruy/ruy/profiler/instrumentation.cc
+  CORE_CC_ALL_SRCS += $(root)/tensorflow/lite/tools/make/downloads/ruy/ruy/profiler/profiler.cc
+  CORE_CC_ALL_SRCS += $(root)/tensorflow/lite/tools/make/downloads/ruy/ruy/profiler/treeview.cc
+  CXXFLAGS += -DRUY_PROFILER
+endif
+
+# Not to include XNNPACK.
+CXXFLAGS += -DTFLITE_WITHOUT_XNNPACK
+
+BUILD_WITH_NNAPI ?= false
+ifeq ($(BUILD_WITH_NNAPI),true)
+	CORE_CC_ALL_SRCS += $(root)/tensorflow/lite/delegates/nnapi/nnapi_delegate.cc
+	CORE_CC_ALL_SRCS += $(root)/tensorflow/lite/delegates/nnapi/quant_lstm_sup.cc
+	CORE_CC_ALL_SRCS += $(root)/tensorflow/lite/nnapi/nnapi_implementation.cc
+	CORE_CC_ALL_SRCS += $(root)/tensorflow/lite/nnapi/nnapi_util.cc
+	LIBS += -lrt
+else
+	CORE_CC_ALL_SRCS += $(root)/tensorflow/lite/delegates/nnapi/nnapi_delegate_disabled.cc
+	CORE_CC_ALL_SRCS += $(root)/tensorflow/lite/nnapi/nnapi_implementation_disabled.cc
+endif
+
+ifeq ($(TARGET),ios)
+	CORE_CC_EXCLUDE_SRCS += $(root)/tensorflow/lite/minimal_logging_android.cc
+	CORE_CC_EXCLUDE_SRCS += $(root)/tensorflow/lite/minimal_logging_default.cc
+else
+	CORE_CC_EXCLUDE_SRCS += $(root)/tensorflow/lite/minimal_logging_android.cc
+	CORE_CC_EXCLUDE_SRCS += $(root)/tensorflow/lite/minimal_logging_ios.cc
+endif
+
+# Filter out all the excluded files.
+TF_LITE_CC_SRCS := $(filter-out $(CORE_CC_EXCLUDE_SRCS), $(CORE_CC_ALL_SRCS))
+
+# Benchmark sources
+BENCHMARK_SRCS_DIR := $(root)/tensorflow/lite/tools/benchmark
+DELEGATE_PROVIDER_SRCS_DIR := $(root)/tensorflow/lite/tools/delegates
+EVALUATION_UTILS_SRCS := \
+  $(root)/tensorflow/lite/tools/evaluation/utils.cc
+BENCHMARK_ALL_SRCS := \
+	$(wildcard $(BENCHMARK_SRCS_DIR)/*.cc) \
+	$(PROFILE_SUMMARIZER_SRCS) \
+	$(CMD_LINE_TOOLS_SRCS) \
+	$(EVALUATION_UTILS_SRCS) \
+	$(DELEGATE_PROVIDER_SRCS_DIR)/delegate_provider.cc \
+	$(DELEGATE_PROVIDER_SRCS_DIR)/default_execution_provider.cc
+
+BENCHMARK_MAIN_SRC := $(BENCHMARK_SRCS_DIR)/benchmark_main.cc
+BENCHMARK_PERF_OPTIONS_SRC := \
+	$(BENCHMARK_SRCS_DIR)/benchmark_tflite_performance_options_main.cc
+BENCHMARK_LIB_SRCS := $(filter-out \
+	$(wildcard $(BENCHMARK_SRCS_DIR)/*_test.cc) \
+	$(BENCHMARK_MAIN_SRC) \
+	$(BENCHMARK_PERF_OPTIONS_SRC) \
+	$(BENCHMARK_SRCS_DIR)/benchmark_plus_flex_main.cc \
+  $(DELEGATE_PROVIDER_SRCS_DIR)/external_delegate_provider.cc \
+	$(DELEGATE_PROVIDER_SRCS_DIR)/gpu_delegate_provider.cc \
+	$(DELEGATE_PROVIDER_SRCS_DIR)/hexagon_delegate_provider.cc \
+	$(DELEGATE_PROVIDER_SRCS_DIR)/nnapi_delegate_provider.cc \
+	$(DELEGATE_PROVIDER_SRCS_DIR)/xnnpack_delegate_provider.cc, \
+	$(BENCHMARK_ALL_SRCS))
+
+# These target-specific makefiles should modify or replace options like
+# CXXFLAGS or LIBS to work for a specific targeted architecture. All logic
+# based on platforms or architectures should happen within these files, to
+# keep this main makefile focused on the sources and dependencies.
+# include $(wildcard $(MAKEFILE_DIR)/targets/*_makefile.inc)
+
+ALL_SRCS := \
+	$(MINIMAL_SRCS) \
+	$(PROFILER_SRCS) \
+	$(PROFILER_SUMMARIZER_SRCS) \
+	$(TF_LITE_CC_SRCS) \
+	$(BENCHMARK_LIB_SRCS) \
+	$(CMD_LINE_TOOLS_SRCS)
+
+# Where compiled objects are stored.
+TARGET_OUT_DIR ?= $(TARGET)_$(TARGET_ARCH)
+ifeq ($(PREFIX),0)
+GENDIR := $(MAKEFILE_DIR)/gen/$(TARGET_OUT_DIR)
+else
+GENDIR := $(PREFIX)
+endif
+OBJDIR := $(GENDIR)/obj
+BINDIR := $(GENDIR)/bin
+LIBDIR := $(GENDIR)/lib
+INCDIR := $(GENDIR)/inc
+
+# INSTALL_LITE_FILES := $(patsubst $(TF_LITE)%, $(INCDIR)tensorflow/lite%, $(INCLUDES_FILES))
+# INSTALL_ABSL_FILES := $(patsubst $(MAKEFILE_DIR)/downloads/absl/%, $(INCDIR)%, $(INCLUDES_FILES))
+# INSTALL_FILES = $(INSTALL_LITE_FILES) $(INSTALL_ABSL_FILES)
+
+# .PHONY: check-inc
+# check-inc:
+# 	@echo include files
+#	@echo $(INCLUDES_FILES)
+#	@echo _
+#	@echo _
+#	@echo install files
+#	@echo $(INSTALL_FILES)
+
+SLIB_PATH := $(LIBDIR)/$(SLIB_NAME)
+DLIB_PATH := $(LIBDIR)/$(DLIB_NAME)
+BENCHMARK_LIB := $(LIBDIR)/$(BENCHMARK_LIB_NAME)
+BENCHMARK_BINARY := $(BINDIR)/$(BENCHMARK_BINARY_NAME)
+BENCHMARK_PERF_OPTIONS_BINARY := $(BINDIR)/$(BENCHMARK_PERF_OPTIONS_BINARY_NAME)
+MINIMAL_BINARY := $(BINDIR)/minimal
+LABEL_IMAGE_BINARY := $(BINDIR)/label_image
+
+CXX := $(CC_PREFIX)${TARGET_TOOLCHAIN_PREFIX}g++
+CC := $(CC_PREFIX)${TARGET_TOOLCHAIN_PREFIX}gcc
+AR := $(CC_PREFIX)${TARGET_TOOLCHAIN_PREFIX}ar
+
+MINIMAL_OBJS := $(addprefix $(OBJDIR)/, \
+$(patsubst %.cc,%.o,$(patsubst %.c,%.o,$(MINIMAL_SRCS))))
+
+LABEL_IMAGE_OBJS := $(addprefix $(OBJDIR)/, \
+$(patsubst %.cc,%.o,$(patsubst %.c,%.o,$(LABEL_IMAGE_SRCS) $(CMD_LINE_TOOLS_SRCS))))
+
+LIB_OBJS := $(addprefix $(OBJDIR)/, \
+$(patsubst %.cc,%.o,$(patsubst %.c,%.o,$(patsubst %.cpp,%.o,$(TF_LITE_CC_SRCS)))))
+
+BENCHMARK_MAIN_OBJ := $(addprefix $(OBJDIR)/, \
+$(patsubst %.cc,%.o,$(patsubst %.c,%.o,$(BENCHMARK_MAIN_SRC))))
+
+BENCHMARK_PERF_OPTIONS_OBJ := $(addprefix $(OBJDIR)/, \
+$(patsubst %.cc,%.o,$(patsubst %.c,%.o,$(BENCHMARK_PERF_OPTIONS_SRC))))
+
+BENCHMARK_LIB_OBJS := $(addprefix $(OBJDIR)/, \
+$(patsubst %.cc,%.o,$(patsubst %.c,%.o,$(BENCHMARK_LIB_SRCS))))
+
+# For normal manually-created TensorFlow Lite C++ source files.
+$(OBJDIR)/%.o: %.cpp
+	@mkdir -p $(dir $@)
+	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@
+
+$(OBJDIR)/%.o: %.cc
+	@mkdir -p $(dir $@)
+	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@
+
+# For normal manually-created TensorFlow Lite C source files.
+$(OBJDIR)/%.o: %.c
+	@mkdir -p $(dir $@)
+	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@
+
+# The target that's compiled if there's no command-line arguments.
+.PHONY: all
+ifeq ($(TENSORFLOW_BUILD_BENCHMARK_TOOL),y)
+all: lib $(BENCHMARK_BINARY) $(BENCHMARK_PERF_OPTIONS_BINARY) install
+else
+all: micro
+endif
+
+# The target that's compiled for micro-controllers
+.PHONY: micro
+micro: lib
+
+.PHONY: install
+install: install-header
+
+.PHONY: uninstall-header
+uninstall-header:
+	@rm -rf $(INCDIR)
+
+# Hack for generating schema files bypassing flatbuffer parsing
+$(root)/tensorflow/lite/schema/schema_generated.h:
+	@cp -u $(root)/tensorflow/lite/schema/schema_generated.h.oss $(root)/tensorflow/lite/schema/schema_generated.h
+
+# Gathers together all the objects we've compiled into a single '.a' archive.
+$(SLIB_PATH): $(root)/tensorflow/lite/schema/schema_generated.h $(LIB_OBJS)
+	@mkdir -p $(dir $@)
+	$(AR) $(ARFLAGS) $@ $(LIB_OBJS)
+
+# Gathers together all the objects as single shared library '.so'
+$(DLIB_PATH): $(LIB_OBJS)
+	@mkdir -p $(dir $@)
+	$(CXX) -shared -Wl,--build-id -Wl,--soname,$(DLIB_NAME_RAW) -o $@ $^
+	cd $(LIBDIR) && ln -sf $(DLIB_NAME) $(DLIB_NAME_RAW) && cd -
+
+.PHONY: lib
+lib: $(SLIB_PATH) $(DLIB_PATH)
+
+TARGET_LITE_INC = $(subst $(TF_LITE)/, $(INCDIR)/tensorflow/lite/, $(LITE_INCLUDES))
+TARGET_ABSL_INC = $(subst $(MAKEFILE_DIR)/downloads/absl/, $(INCDIR)/, $(ABSL_INCLUDES))
+TARGET_FLATB_INC = $(subst $(MAKEFILE_DIR)/downloads/flatbuffers/include/, $(INCDIR)/, $(FLATBUFFERS_INCLUDES))
+
+.PHONY: install-header
+#install-header: $(LITE_INCLUDES) $(ABSL_INCLUDES) $(FLATBUFFERS_INCLUDES)
+install-header: $(TARGET_LITE_INC) $(TARGET_ABSL_INC) $(TARGET_FLATB_INC)
+	@echo INSTALL headers
+	@echo INSTALL $(INCDIR)/tensorflow/lite
+	@echo INSTALL $(INCDIR)/absl
+	@echo INSTALL $(INCDIR)/flatbuffers
+
+$(INCDIR)/tensorflow/lite/% : $(TF_LITE)/%
+	@mkdir -p $(dir $@)
+	$(Q)install -m 666 $< $@
+
+$(INCDIR)/% : $(MAKEFILE_DIR)/downloads/absl/%
+	@mkdir -p $(dir $@)
+	$(Q)install -m 666 $< $@
+
+$(INCDIR)/% : $(MAKEFILE_DIR)/downloads/flatbuffers/include/%
+	@mkdir -p $(dir $@)
+	$(Q)install -m 666 $< $@
+
+#$(LITE_INCLUDES):
+#	@install -d $(dir $(INCDIR)tensorflow/lite$@)
+#	@install -m 666 $(TF_LITE)$@ $(INCDIR)tensorflow/lite$@
+
+#$(ABSL_INCLUDES):
+#	@install -d $(dir $(INCDIR)$@)
+#	@install -m 666 $(MAKEFILE_DIR)/downloads/absl/$@ $(INCDIR)$@
+
+#$(FLATBUFFERS_INCLUDES):
+#	@install -d $(dir $(INCDIR)$@)
+#	@install -m 666 $(MAKEFILE_DIR)/downloads/flatbuffers/include/$@ $(INCDIR)$@
+
+#$(MINIMAL_BINARY): $(MINIMAL_OBJS) $(LIB_PATH)
+#	@mkdir -p $(dir $@)
+#	$(CXX) $(CXXFLAGS) $(INCLUDES) \
+#	-o $(MINIMAL_BINARY) $(MINIMAL_OBJS) \
+#	$(LIBFLAGS) $(LIB_PATH) $(LDFLAGS) $(LIBS)
+
+#minimal: $(MINIMAL_BINARY)
+
+#$(LABEL_IMAGE_BINARY): $(LABEL_IMAGE_OBJS) $(LIB_PATH)
+#	@mkdir -p $(dir $@)
+#	$(CXX) $(CXXFLAGS) $(INCLUDES) \
+#	-o $(LABEL_IMAGE_BINARY) $(LABEL_IMAGE_OBJS) \
+#	$(LIBFLAGS) $(LIB_PATH) $(LDFLAGS) $(LIBS)
+
+#label_image: $(LABEL_IMAGE_BINARY)
+
+$(BENCHMARK_LIB) : $(LIBDIR) $(BENCHMARK_LIB_OBJS)
+	@mkdir -p $(dir $@)
+	$(AR) $(ARFLAGS) $(BENCHMARK_LIB) $(LIB_OBJS) $(BENCHMARK_LIB_OBJS)
+
+benchmark_lib: $(BENCHMARK_LIB)
+
+BENCHMARK_LINKOPTS :=
+ifeq ($(HOST_OS),osx)
+	BENCHMARK_LINKOPTS += $(LIBFLAGS) -Wl,-force_load $(BENCHMARK_LIB) $(LIBS) $(LDFLAGS) -framework CoreFoundation
+else
+	BENCHMARK_LINKOPTS += $(LIBFLAGS) -Wl,--whole-archive $(BENCHMARK_LIB) -Wl,--no-whole-archive $(LDFLAGS) $(LIBS)
+endif
+
+$(BENCHMARK_BINARY) : $(BENCHMARK_MAIN_OBJ) $(BENCHMARK_LIB)
+	@mkdir -p $(dir $@)
+	$(CXX) $(CXXFLAGS) $(INCLUDES) \
+	-o $(BENCHMARK_BINARY) $(BENCHMARK_MAIN_OBJ) \
+	$(LIBFLAGS) $(BENCHMARK_LINKOPTS)
+
+$(BENCHMARK_PERF_OPTIONS_BINARY) : $(BENCHMARK_PERF_OPTIONS_OBJ) $(BENCHMARK_LIB)
+	@mkdir -p $(dir $@)
+	$(CXX) $(CXXFLAGS) $(INCLUDES) \
+	-o $(BENCHMARK_PERF_OPTIONS_BINARY) $(BENCHMARK_PERF_OPTIONS_OBJ) \
+	$(LIBFLAGS) $(BENCHMARK_LIB) $(LDFLAGS) $(LIBS)
+
+benchmark: $(BENCHMARK_BINARY) $(BENCHMARK_PERF_OPTIONS_BINARY)
+
+# Gets rid of all generated files.
+.PHONY: clean
+clean:
+	rm -rf $(GENDIR)
+
+.PHONY: clean-obj
+clean-obj:
+	rm -rf $(OBJDIR)
+
+.PHONY: call
+call:
+	@echo ======== $(TARGET_LITE_INC) 
+	@echo ======== $(TARGET_ABSL_INC)
+	@echo ======== $(FLATBUFFERS_INCLUDES)
+	@echo ======== $(MAKEFILE_DIR)/downloads/flatbuffers/include/ $($INCDIR)/
+	@echo ======== $(TARGET_FLATB_INC)
+# Gets rid of target files only, leaving the host alone. Also leaves the lib
+# directory untouched deliberately, so we can persist multiple architectures
+# across builds for iOS and Android.
+cleantarget:
+	rm -rf $(OBJDIR)
+	rm -rf $(BINDIR)
+
+$(DEPDIR)/%.d: ;
+.PRECIOUS: $(DEPDIR)/%.d
+
+-include $(patsubst %,$(DEPDIR)/%.d,$(basename $(ALL_SRCS)))
