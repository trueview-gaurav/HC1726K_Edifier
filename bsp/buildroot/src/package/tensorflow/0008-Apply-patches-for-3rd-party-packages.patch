From 7eccf8b00c924b58da6bd6fa1ca47cbc51072d00 Mon Sep 17 00:00:00 2001
From: "Jason.Lin im247" <Jason.Lin@augentix.com>
Date: Wed, 1 Apr 2026 18:53:50 +0800
Subject: [PATCH 8/8] Apply patches for 3rd-party packages

---
 Makefile.third_party                       |   19 +-
 patches/0001-fix-farmhash-mismatch.patch   |   10 +
 patches/0002-fix-neon_2_sse-mismatch.patch | 1299 ++++++++++++++++++++
 3 files changed, 1325 insertions(+), 3 deletions(-)
 create mode 100644 patches/0001-fix-farmhash-mismatch.patch
 create mode 100644 patches/0002-fix-neon_2_sse-mismatch.patch

diff --git a/Makefile.third_party b/Makefile.third_party
index bd3fcd8b..f9a4b238 100644
--- a/Makefile.third_party
+++ b/Makefile.third_party
@@ -3,7 +3,7 @@ root = $(realpath $(CURDIR))
 TF_PATH =$(root)
 TFLITE_PATH =$(TF_PATH)/tensorflow/lite
 TFLITE_MAKEFILE_DIR =$(TFLITE_PATH)/tools/make
-
+TFLITE_PATCH_DIR := $(TF_PATH)/patches
 
 .PHONY: tflite-del-dl
 tflite-del-dl:
@@ -11,6 +11,19 @@ tflite-del-dl:
 
 .PHONY: tflite-dl-3rd
 tflite-dl-3rd:
-	@echo Downloading 3rd party libraries ...
-	$(TFLITE_MAKEFILE_DIR)/download_dependencies.sh
+	@echo ">>> Downloading 3rd party libraries ..."
+	@$(TFLITE_MAKEFILE_DIR)/download_dependencies.sh || true
+	@echo ">>> Applying local patches from $(TFLITE_PATCH_DIR) ..."
+	@for p in $(TFLITE_PATCH_DIR)/*.patch; do \
+	  [ -f $$p ] || continue; \
+	  echo "---- patch: $$p"; \
+	  if patch --dry-run -p1 < $$p >/dev/null 2>&1; then \
+		patch --batch --forward -p1 < $$p || echo "WARN: patch -p1 failed for $$p" >&2; \
+	  elif patch --dry-run -p0 < $$p >/dev/null 2>&1; then \
+		patch --batch --forward -p0 < $$p || echo "WARN: patch -p0 failed for $$p" >&2; \
+	  else \
+		echo "WARNING: could not auto-apply $$p; please inspect and apply manually." >&2; \
+	  fi; \
+	done
+	@echo ">>> patch step completed."
 
