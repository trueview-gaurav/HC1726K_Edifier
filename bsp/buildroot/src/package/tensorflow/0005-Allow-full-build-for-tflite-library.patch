diff --git a/Makefile.tmp b/Makefile.tmp
new file mode 100644
index 00000000..ef733dc5
--- /dev/null
+++ b/Makefile.tmp
@@ -0,0 +1,97 @@
+TENSORFLOW_VERSION = 2.6.0
+TENSORFLOW_SOURCE = v$(TF_VERSION).tar.gz
+TENSORFLOW_SITE = https://github.com/tensorflow/tensorflow/archive/refs/tags
+TENSORFLOW_INSTALL_STAGING = YES
+TENSORFLOW_LICENSE = Apache-2.0 
+TENSORFLOW_LICENSE_FILES = LICENSE
+TENSORFLOW_CPE_ID_VENDOR = tensorflow
+TFLITE_MICRO_MK_PATH = tensorflow/lite/micro/tools/make
+
+BR2_PACKAGE_TENSORFLOW_MICROLITE=n
+BR2_PACKAGE_TENSORFLOW_LITE=y
+BR2_PACKAGE_TENSORFLOW_LITE_OPTIM=y
+
+TFLITE_OPTIM=n
+TFLITE_NAME=
+
+ifeq ($(BR2_PACKAGE_TENSORFLOW_LITE_OPTIM), y)
+TFLITE_OPTIM=y
+OPTIM_NAME=_optim
+endif
+
+ifeq ($(CROSS_COMPILE), arm-linux-gnueabihf-)
+TFLITE_BUILD_PREFIX = $(realpath $(CURDIR))/tflite_hc17x3_fpu$(OPTIM_NAME)
+MICROLITE_BUILD_PREFIX = $(realpath $(CURDIR))/microlite_hc17x3_fpu
+MICROLITE_OPTIMIZED_KERNEL_DIR = cmsis_nn
+BR2_GCC_TARGET_CPU = cortex-a7
+BR2_ARM_CPU_HAS_NEON = y
+else ifeq ($(CROSS_COMPILE), arm-linux-gnueabi-)
+TFLITE_BUILD_PREFIX = $(realpath $(CURDIR))/tflite_hc17x3$(OPTIM_NAME)
+MICROLITE_BUILD_PREFIX = $(realpath $(CURDIR))/microlite_hc17x3
+BR2_GCC_TARGET_CPU = cortex-a7
+BR2_ARM_CPU_HAS_NEON = n
+else ifeq ($(CROSS_COMPILE), arm-augentix-linux-gnueabi-)
+TFLITE_BUILD_PREFIX = $(realpath $(CURDIR))/tflite_hc17x2$(OPTIM_NAME)
+MICROLITE_BUILD_PREFIX = $(realpath $(CURDIR))/microlite_hc17x2
+BR2_GCC_TARGET_CPU = arm926ej-s
+BR2_ARM_CPU_HAS_NEON = n
+else ifeq ($(CROSS_COMPILE),)
+TFLITE_BUILD_PREFIX = $(realpath $(CURDIR))/tflite_linux$(OPTIM_NAME)
+MICROLITE_BUILD_PREFIX = $(realpath $(CURDIR))/microlite_linux
+BR2_GCC_TARGET_CPU =
+BR2_ARM_CPU_HAS_NEON = o
+endif
+
+TENSORFLOW_COMMON_FLAGS = \
+-Wall \
+-fPIC \
+-funsafe-math-optimizations \
+-ftree-vectorize \
+-fdata-sections \
+-ffunction-sections
+
+
+ifeq ($(BR2_GCC_TARGET_CPU), arm926ej-s)
+TENSORFLOW_COMMON_FLAGS += \
+-DGEMMLOWP_ALLOW_SLOW_SCALAR_FALLBACK \
+-mcpu=arm926ej-s \
+-D__ARM_FP=0
+TFLITE_BUILD_WITH_RUY = false
+endif
+
+ifeq ($(BR2_GCC_TARGET_CPU), cortex-a7)
+TENSORFLOW_COMMON_FLAGS += -mcpu=cortex-a7
+TFLITE_BUILD_WITH_RUY = true
+endif
+
+ifeq ($(BR2_ARM_CPU_HAS_NEON), y)
+TENSORFLOW_COMMON_FLAGS += \
+-mfloat-abi=hard \
+-mfpu=neon-vfpv4
+else ifeq ($(BR2_ARM_CPU_HAS_NEON), n)
+TENSORFLOW_COMMON_FLAGS += -mfloat-abi=soft
+endif
+
+ifeq ($(BR2_PACKAGE_TENSORFLOW_LITE_OPTIM), y)
+TENSORFLOW_COMMON_FLAGS+=-DTFLITE_OPTIM
+endif
+
+ifeq ($(BR2_PACKAGE_TENSORFLOW_MICROLITE), y)
+ifeq ($(BR2_ARM_CPU_HAS_NEON), y)
+MICROLITE_OPTIMIZED_KERNEL_DIR=cmsis_nn
+endif
+endif
+
+ifeq ($(BR2_PACKAGE_TFLITE_BENCHMARK_TOOL), y)
+TENSORFLOW_BUILD_BENCHMARK_TOOL = y
+endif
+
+TENSORFLOW_TOOLCHAIN_PREFIX = $(CROSS_COMPILE)
+
+TENSORFLOW_LD_FLAGS = \
+-lstdc++ \
+-lpthread \
+-lm \
+-ldl 
+
+TENSORFLOW_MICROLITE_TARGET=ARM
\ No newline at end of file
