+#if NCNN_INT8
+int BinaryOp::load_model(const ModelBin& mb)
+{
+    if (int8_scale_term)
+    {
+        bottom_blob_int8_scales = mb.load(2, 1);
+    }
+
+    if (int8_scale_term > 100)
+    {
+        top_blob_int8_scales = mb.load(1, 1);
+    }
+
+    return 0;
+}
