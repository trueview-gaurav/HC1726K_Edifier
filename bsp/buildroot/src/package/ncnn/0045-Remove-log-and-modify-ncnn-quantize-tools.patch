+            if(layer->type == "BinaryOp"){
+//                conv_layers.push_back(i);
+                fprintf(stderr, "bottom size = %d\n", layer->bottoms.size());
+                fprintf(stderr, "push blob id %d", layer->bottoms[1]);
+//                fprintf(stderr, "= %s\n", layers[layer->bottoms[1]]->name.c_str());
+                conv_bottom_blobs.push_back(layer->bottoms[1]);
+            }
+            conv_top_blobs.push_back(layer->tops[0]); // for EQ
         }
     }
 
