             continue;
 
+
         // fuse requantize
-//        fprintf(stderr, "fuse_requantize %s %s\n", layers[i]->name.c_str(), layers[j]->name.c_str());
+        fprintf(stderr, "tried to fuse %s %s\n", layers[i]->name.c_str(), layers[j]->name.c_str());
 
         if (layers[i]->type == "Convolution" && layers[j]->type == "Convolution")
         {
@@ -481,6 +482,8 @@ int NetQuantize::fuse_requantize()
         {
             ncnn::BinaryOp* convolution1 = (ncnn::BinaryOp*)layers[i];
             ncnn::BinaryOp* convolution2 = (ncnn::BinaryOp*)layers[j];
+            if (convolution1->int8_scale_term !=2 || convolution2->int8_scale_term !=2)
+                continue;
 
             convolution1->int8_scale_term += 100;
             convolution1->top_blob_int8_scales = convolution2->bottom_blob_int8_scales.range(bottom_blob_index,1);
@@ -511,6 +514,7 @@ int NetQuantize::fuse_requantize()
             fprintf(stderr, "fuse_requantize %s %s %f\n", layers[i]->name.c_str(), layers[j]->name.c_str(), convolution1->top_blob_int8_scales[0]);
         }
     }
+    fprintf(stderr, "Start fusing op with multiple layers \n");
 
     for (size_t i = 0; i < layer_count; i++)
     {
@@ -519,7 +523,7 @@ int NetQuantize::fuse_requantize()
 
         // Convolution/ConvolutionDepthWise/BinaryOp - (Pooling/ Split/ Concat/ ShuffleChannel/ Crop) * N - Convolution/ConvolutionDepthWise/BinaryOp
         int top_blob_index = layers[i]->tops[0];
-        printf("On %s %d\n", layers[i]->name.c_str(), (int)i);
+        fprintf(stderr, "On %s %d\n", layers[i]->name.c_str(), (int)i);
         size_t j = i + 1;
 
         int bottom_blob_index = 0;
