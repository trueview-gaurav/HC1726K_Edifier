 src/layer/convolutiondepthwise.cpp            | 18 ++++-
 src/layer/innerproduct.cpp                    | 10 +++
 src/layer/pooling.cpp                         |  6 +-
 src/platform.h.in                             |  1 +
 ...ntix-linux-uclibcgnueabihf.toolchain.cmake | 28 ++++++++
 11 files changed, 209 insertions(+), 13 deletions(-)
 create mode 100755 toolchains/arm-augentix-linux-uclibcgnueabihf.toolchain.cmake

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 3101fa21..d83acd4c 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -203,7 +203,11 @@ else()
 endif()
 
 if(NCNN_OPTIMAL)
-    set_target_properties(ncnn PROPERTIES OUTPUT_NAME "ncnn-optim")
+    set_target_properties(ncnn PROPERTIES OUTPUT_NAME "ncnn-minimal")
+endif()
+
+if(NCNN_COMPACT)
+    set_target_properties(ncnn PROPERTIES OUTPUT_NAME "ncnn-compact")
 endif()
 
 include(GenerateExportHeader)
