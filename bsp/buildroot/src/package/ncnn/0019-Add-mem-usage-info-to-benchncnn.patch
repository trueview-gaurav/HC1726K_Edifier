 #ifdef __EMSCRIPTEN__
 #include <emscripten.h>
@@ -87,6 +88,9 @@ void benchmark(const char* comment, const std::vector<ncnn::Mat>& _in, const ncn
 #define MODEL_DIR ""
 #endif
 
+	struct rusage usage_start, usage_end;
+	getrusage(RUSAGE_SELF, &usage_start);
+
     if (fixed_path)
     {
         char parampath[256];
@@ -116,6 +120,8 @@ void benchmark(const char* comment, const std::vector<ncnn::Mat>& _in, const ncn
         return;
     }
 
+	
+
     // initialize input
     for (size_t j = 0; j < input_names.size(); ++j)
     {
@@ -144,6 +150,8 @@ void benchmark(const char* comment, const std::vector<ncnn::Mat>& _in, const ncn
     double time_max = -DBL_MAX;
     double time_avg = 0;
 
+	
+
     for (int i = 0; i < g_loop_count; i++)
     {
         double start = ncnn::get_current_time();
@@ -170,10 +178,13 @@ void benchmark(const char* comment, const std::vector<ncnn::Mat>& _in, const ncn
         time_max = std::max(time_max, time);
         time_avg += time;
     }
+	getrusage(RUSAGE_SELF, &usage_end);
 
     time_avg /= g_loop_count;
 
-    fprintf(stderr, "%20s  min = %7.2f  max = %7.2f  avg = %7.2f\n", comment, time_min, time_max, time_avg);
+	long mem_usage = usage_end.ru_maxrss - usage_start.ru_maxrss;
+
+    fprintf(stderr, "%20s  min = %7.2f  max = %7.2f  avg = %7.2f  mem = %ld KB\n", comment, time_min, time_max, time_avg, mem_usage);
 }
 
 void benchmark(const char* comment, const ncnn::Mat& _in, const ncnn::Option& opt, bool fixed_path = true)
@@ -385,7 +396,7 @@ int main(int argc, char** argv)
     fprintf(stderr, "powersave = %d\n", ncnn::get_cpu_powersave());
     fprintf(stderr, "gpu_device = %d\n", gpu_device);
