From 0985de90dd7e6d728edfb96468f438ff9379dfdc Mon Sep 17 00:00:00 2001
From: "Jason.Lin im247" <Jason.Lin@augentix.com>
Date: Wed, 6 Dec 2023 11:07:58 +0800
Subject: [PATCH 21/54] Add int8 fill function

---
 src/mat.h | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/mat.h b/src/mat.h
index e3520a3c..08495a71 100644
--- a/src/mat.h
+++ b/src/mat.h
@@ -104,6 +104,7 @@ public:
     // set all
     void fill(float v);
     void fill(int v);
+    void fill(signed char v);
 #if __ARM_NEON
     void fill(float32x4_t _v);
     void fill(uint16x4_t _v);
@@ -936,6 +937,18 @@ NCNN_FORCEINLINE void Mat::fill(int _v)
     }
 }
 
+NCNN_FORCEINLINE void Mat::fill(signed char _v)
+{
+    int size = (int)total();
+    signed char* ptr = (signed char*)data;
+
+    int i = 0;
+    for (; i < size; i++)
+    {
+        *ptr++ = _v;
+    }
+}
+
 #if __ARM_NEON
 NCNN_FORCEINLINE void Mat::fill(float32x4_t _v)
 {
