Subject: [PATCH 42/54] Add unit test condition for BinrayOp(ADD)

---
 tests/test_binaryop_int8.cpp | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/tests/test_binaryop_int8.cpp b/tests/test_binaryop_int8.cpp
index 13eeac82..73083086 100755
--- a/tests/test_binaryop_int8.cpp
+++ b/tests/test_binaryop_int8.cpp
@@ -49,6 +49,7 @@ static int test_binaryop(const ncnn::Mat& _a, const ncnn::Mat& _b, int flag)
     ncnn::Option opt;
     opt.num_threads = 1;
     opt.use_packing_layout = true;
+    opt.use_int8_inference = true;
 
     ncnn::ParamDict pd;
     pd.set(0, op_type);
@@ -91,11 +92,11 @@ static int test_binaryop(const ncnn::Mat& _a, const ncnn::Mat& _b, int flag)
 
 static int test_binaryop_3()
 {
-    const int ws[] = {8, 16};
-    const int hs[] = {8, 16};
-    const int cs[] = {8, 16};
+    const int ws[] = {2, 3, 4};
+    const int hs[] = {3, 3, 4};
+    const int cs[] = {2, 3, 2};
 
-    for (int i = 0; i < 1; i++)
+    for (int i = 0; i < 3; i++)
     {
         const int w = ws[i];
         const int h = hs[i];
@@ -117,7 +118,7 @@ static int test_binaryop_3()
 int main()
 {
     SRAND(7767517);
-
+#if NCNN_INT8
     for (op_type = 0; op_type < 1; op_type++)
     {
         int ret = test_binaryop_3();
@@ -125,7 +126,10 @@ int main()
         if (ret != 0)
             return ret;
     }
-
+#else
+    NCNN_LOGE("NOT SUPPORT INT8");
+    return -1;
+#endif
     return 0;
 }
 
