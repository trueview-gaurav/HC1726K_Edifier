Subject: [PATCH 38/54] Add requantization support for BinaryOp

---
 tools/modelwriter.h          |  11 +
 tools/quantize/ncnn2int8.cpp | 496 +++++++++++++++--------------------
 2 files changed, 217 insertions(+), 290 deletions(-)

diff --git a/tools/modelwriter.h b/tools/modelwriter.h
index fd5105e6..a116373c 100644
--- a/tools/modelwriter.h
+++ b/tools/modelwriter.h
@@ -834,6 +834,17 @@ int ModelWriter::save(const char* parampath, const char* binpath)
             fprintf_param_value(" 0=%d", op_type)
             fprintf_param_value(" 1=%d", with_scalar)
             fprintf_param_value(" 2=%e", b)
+            fprintf_param_value(" 8=%d", int8_scale_term)
+
+#if NCNN_INT8
+            // write int8_scale data
+            if (op->int8_scale_term)
+            {
+                fwrite_weight_data(op->bottom_blob_int8_scales, bp, 0.001, 1);
+                fwrite_weight_data(op->top_blob_int8_scales, bp, 0.001, 1);
+            }
+#endif // NCNN_INT8
+
         }
         else if (layer->type == "Clip")
         {
