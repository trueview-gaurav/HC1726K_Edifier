+int NetQuantize::quantize_binaryop()
+{
+    const int layer_count = static_cast<int>(layers.size());
+    for (int i = 0; i < layer_count; i++)
+    {
+        // find BinaryOp layer
+        if (layers[i]->type != "BinaryOp")
+            continue;
+
+        // find InnerProduct layer
+        std::map<std::string, ncnn::Mat>::iterator iter_data = blob_int8scale_table.find(layers[i]->name);
+        if (iter_data == blob_int8scale_table.end()){
+            printf("blob_int8scale_table not found BinaryOp\n");
+            continue;
+        }else{
+            printf("blob_int8scale_table found BinaryOp\n");
+        }
+
+
+//        char key[256];
+//        sprintf(key, "%s_param_0", layers[i]->name.c_str());
+//
+//        std::map<std::string, ncnn::Mat>::iterator iter = weight_int8scale_table.find(key);
+//        if (iter == weight_int8scale_table.end())
+//        {
+//            fprintf(stderr, "this layer need to be quantized, but no scale param!\n");
+//            return -1;
+//        }
+//
+//        // InnerProduct - quantize weight from fp32 to int8
+        ncnn::BinaryOp* bo = (ncnn::BinaryOp*)layers[i];
+//
+        ncnn::Mat bottom_blob_int8_scales = iter_data->second;
+//        ncnn::Mat weight_data_int8_scales = iter->second;
+//
+        fprintf(stderr, "quantize_binaryop %s\n", bo->name.c_str());
+//
+        bo->int8_scale_term = 2;
+//        bo->weight_data_int8_scales = weight_data_int8_scales;
+        bo->bottom_blob_int8_scales = bottom_blob_int8_scales;
+        printf("bottom_blob_int8_scales = %f %f\n", bottom_blob_int8_scales[0], bottom_blob_int8_scales[1]);
+    }
+
+    return 0;
+}
