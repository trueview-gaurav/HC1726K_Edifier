+
+#include "layer/binaryop.h"
+#include "testutil.h"
+
+#define OP_TYPE_MAX 12
+
+static int op_type = 0;
+
+void pretty_print_int8(const ncnn::Mat& m)
+{
+    for (int q=0; q<m.c; q++)
+    {
+        const signed char* ptr = m.channel(q);
+        for (int z=0; z<m.d; z++)
+        {
+            for (int y=0; y<m.h; y++)
+            {
+                for (int x=0; x<m.w; x++)
+                {
+                    printf("%4d ", ptr[x]);
+                }
+                ptr += m.w;
+                printf("\n");
+            }
+            printf("\n");
+        }
+        printf("------------------------\n");
+    }
+}
+
+static int test_binaryop(const ncnn::Mat& _a, const ncnn::Mat& _b, int flag)
+{
+    ncnn::Mat a = _a;
+    ncnn::Mat b = _b;
+
+    ncnn::Option opt;
+    opt.num_threads = 1;
+    opt.use_packing_layout = true;
+
+    ncnn::ParamDict pd;
+    pd.set(0, op_type);
+    pd.set(1, 0);   // with_scalar
+    pd.set(2, 0.f); // b
+    pd.set(8, 102);
+
+    std::vector<ncnn::Mat> ab(2);
+    ab[0] = a;
+    ab[1] = b;
+    std::vector<ncnn::Mat> top_blobs(1);
+//    Mat& top_blob = top_blobs[0];
+//    if (outdims == 1)
+//    {
+//        top_blob.create(outw, out_elemsize, out_elempack, opt.blob_allocator);
+
+    ncnn::BinaryOp* bo = (ncnn::BinaryOp*)ncnn::create_layer("BinaryOp");
+    bo->load_param(pd);
+    printf("Loaded\n");
+    bo->bottom_blob_int8_scales = RandomMat(2, 30.f, 100.f);
+    bo->top_blob_int8_scales = RandomMat(1, 30.f, 100.f);
+    printf("Init\n");
+    bo->forward(ab, top_blobs, opt);
+    printf("Forwarded\n");
+    printf("bottom_blob_int8_scales: %f %f\n", bo->bottom_blob_int8_scales[0], bo->bottom_blob_int8_scales[1]);
+    printf("top_blob_int8_scales: %f\n", bo->top_blob_int8_scales[0]);
+
+    printf("==============Input 0===============\n");
+    pretty_print_int8(ab[0]);
+    printf("====================================\n");
+    printf("==============Input 1===============\n");
+    pretty_print_int8(ab[1]);
+    printf("====================================\n");
+    printf("===============Output===============\n");
+    pretty_print_int8(top_blobs[0]);
+    printf("====================================\n");
+
+    return 0;
+}
+
+static int test_binaryop_3()
+{
+    const int ws[] = {8, 16};
+    const int hs[] = {8, 16};
+    const int cs[] = {8, 16};
+
+    for (int i = 0; i < 1; i++)
+    {
+        const int w = ws[i];
+        const int h = hs[i];
+        const int c = cs[i];
+        const int flag = c == 32 ? TEST_LAYER_DISABLE_GPU_TESTING : 0;
+
+        ncnn::Mat a[2];
+        a[0] = RandomS8Mat(w, h, c);
+        a[1] = RandomS8Mat(w, h, c);
+
+        int ret = test_binaryop(a[0], a[1], flag);
+        if (ret != 0)
+            return ret;
+    }
+
+    return 0;
+}
+
+int main()
+{
+    SRAND(7767517);
+
+    for (op_type = 0; op_type < 1; op_type++)
+    {
+        int ret = test_binaryop_3();
+
+        if (ret != 0)
+            return ret;
+    }
+
+    return 0;
+}
+
