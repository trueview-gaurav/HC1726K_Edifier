+#include "net.h"
+
+#include <algorithm>
+#if defined(USE_NCNN_SIMPLEOCV)
+#include "simpleocv.h"
+#else
+#include <opencv2/core/core.hpp>
+#include <opencv2/highgui/highgui.hpp>
+#endif
+#include <stdio.h>
+#include <vector>
+
+static int detect(const cv::Mat& bgr, std::vector<float>& cls_scores, const char* paramfile, const char* binfile)
+{
+    ncnn::Net model;
+
+    model.opt.use_vulkan_compute = false;
+    model.opt.use_int8_inference = true;
+    model.opt.use_a53_a55_optimized_kernel = true;
+    model.opt.use_fp16_packed = false;
+    model.opt.use_fp16_storage = false;
+    model.opt.use_fp16_arithmetic = false;
+    model.opt.num_threads = 1;
+
+    // https://github.com/miaow1988/ShuffleNet_V2_pytorch_caffe
+    // models can be downloaded from https://github.com/miaow1988/ShuffleNet_V2_pytorch_caffe/releases
+    fprintf(stderr, "file path: %s", paramfile);
+    if (model.load_param(paramfile))
+        exit(-1);
+    if (model.load_model(binfile))
+        exit(-1);
+
+    ncnn::Mat in = ncnn::Mat::from_pixels_resize(bgr.data, ncnn::Mat::PIXEL_BGR2RGB, bgr.cols, bgr.rows, 128, 128);
+
+    //const float norm_vals[3] = {1 / 255.f, 1 / 255.f, 1 / 255.f};
+    // in.substract_mean_normalize(0, norm_vals);
+    printf("Mat w h c: %d %d %d\n", in.w, in.h, in.c);
+//    const float mean_vals[1] = { 0.44f*255.f }; // 112.2
+//    const float norm_vals[1] = { 1 / 0.265f / 255.f }; // 0.014798382
+    const float mean_vals[3] = {0.457342265910642*255.f, 0.4387686270106377*255.f, 0.4073427106250871*255.f};
+    const float norm_vals[3] = {1 / 0.26753769276329037f / 255.f, 1 / 0.2638145880487105f / 255.f, 1 / 0.2776826934044154f / 255.f};
+
+    in.substract_mean_normalize(mean_vals, norm_vals);
+
+    ncnn::Extractor ex = model.create_extractor();
+
+    ex.input("images", in);
+
+    ncnn::Mat out;
+    ex.extract("output0", out);
+
+    // manually call softmax on the fc output
+    // convert result into probability
+    // skip if your model already has softmax operation
+//    {
+//        // ncnn::Layer* softmax = ncnn::create_layer("Softmax");
+//        ncnn::Layer* sigmoid = ncnn::create_layer("Sigmoid");
+//
+//        ncnn::ParamDict pd;
+//        sigmoid->load_param(pd);
+//
+//        sigmoid->forward_inplace(out, model.opt);
+//
+//        delete sigmoid;
+//    }
+
+    out = out.reshape(out.w * out.h * out.c);
+
+    cls_scores.resize(out.w);
+    for (int j = 0; j < out.w; j++)
+    {
+        cls_scores[j] = out[j];
+    }
+
+    return 0;
+}
+
+static int print_topk(const std::vector<float>& cls_scores, int topk)
+{
+    // partial sort topk with index
+    int size = cls_scores.size();
+    std::vector<std::pair<float, int> > vec;
+    vec.resize(size);
+    for (int i = 0; i < size; i++)
+    {
+        vec[i] = std::make_pair(cls_scores[i], i);
+    }
+
+    std::partial_sort(vec.begin(), vec.begin() + topk, vec.end(),
+                      std::greater<std::pair<float, int> >());
+
+    // print topk and score
+    for (int i = 0; i < topk; i++)
+    {
+        float score = vec[i].first;
+        int index = vec[i].second;
+        fprintf(stderr, "%d = %f\n", index, score);
+    }
+
+    return 0;
+}
+
+int main(int argc, char** argv)
+{
+    if (argc != 4)
+    {
+        fprintf(stderr, "Usage: %s [imagepath]\n", argv[0]);
+        return -1;
+    }
+
+    const char* imagepath = argv[3];
+    const char* paramfile = argv[1];
+    const char* binfile = argv[2];
+
+    cv::Mat m = cv::imread(imagepath, 1);
+    if (m.empty())
+    {
+        fprintf(stderr, "cv::imread %s failed\n", imagepath);
+        return -1;
+    }
+
+    std::vector<float> cls_scores;
+    detect(m, cls_scores, paramfile, binfile);
+
+    print_topk(cls_scores, 7);
+
+    return 0;
+}
