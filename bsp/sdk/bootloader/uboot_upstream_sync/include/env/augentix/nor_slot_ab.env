initrd_high=0xffffffff
ethaddr=02:00:00:00:00:00
wifiaddr=02:00:00:00:00:00
kernel_memaddr=CONFIG_SYS_LOAD_ADDR
kernel_size=CONFIG_AUGENTIX_KERNEL_MAX_SIZE
kernel_0_flashaddr=CONFIG_KERNEL_OFFSET
kernel_1_flashaddr=CONFIG_AUGENTIX_KERNEL_1_OFFSET
rootfs_0_mtdid=CONFIG_AUGENTIX_ROOTFS_MTD_ID
rootfs_1_mtdid=CONFIG_AUGENTIX_ROOTFS_1_MTD_ID
rootfs_mtdid=

bootcounter=0
sysupd_type=dual
factory_reset=0
slot_a_active=1
slot_a_bootable=1
slot_a_successful=0
slot_b_active=0
slot_b_bootable=1
slot_b_successful=0
envsaved=0

loglevel=6
wdt_log=0
bootretry=3

set_boot_slot_a=
	echo Boot from Slot A;
	setenv kernel_flashaddr ${kernel_0_flashaddr};
	setenv rootfs_mtdid ${rootfs_0_mtdid};

set_boot_slot_b=
	echo Boot from Slot B;
	setenv kernel_flashaddr ${kernel_1_flashaddr};
	setenv rootfs_mtdid ${rootfs_1_mtdid};

set_slotargs=
	if test ${slot_b_active} = 1; then
		run set_boot_slot_b;
	else
		run set_boot_slot_a;
	fi;

set_fallback=
	if test ${slot_b_active} = 1; then
		if test ${slot_a_bootable} = 1; then
			setenv slot_a_active 1;
			setenv slot_b_active 0;
		fi;
	else
		if test ${slot_b_bootable} = 1; then
			setenv slot_b_active 1;
			setenv slot_a_active 0;
		fi;
	fi;
	setenv bootcounter 0;

update_bootenv=
	if test ${bootcounter} > 2; then
		echo Switch boot mode...;
		run set_fallback;
	fi;
	if test ${slot_b_active} = 1; then
		if test ${slot_b_successful} != 1; then
			setexpr bootcounter ${bootcounter} + 1;
			saveenv;
		fi;
	else
		if test ${slot_a_successful} != 1; then
			setexpr bootcounter ${bootcounter} + 1;
			saveenv;
		fi;
	fi;

default_boot=
	if test ${envsaved} = 0; then setenv envsaved 1; saveenv; fi;
	run update_bootenv;
	run set_slotargs;
#ifdef CONFIG_SECURE_BOOT
	setenv norroot root=/dev/dm-0 rootfstype=squashfs ro rootwait;
#else
	setenv norroot root=/dev/mtdblock${rootfs_mtdid} rootfstype=squashfs ro rootwait;
#endif
	sf probe;
	run norboot

norboot=
	sf read ${kernel_memaddr} ${kernel_flashaddr} ${kernel_size};
#ifdef CONFIG_SECURE_BOOT
	source ${kernel_memaddr}:script-1;
#endif
	setenv bootargs ${mtdparts} ${norroot}
		console=ttyAS0,CONFIG_BAUDRATE clk_ignore_unused
		ethaddr=${ethaddr} no_console_suspend=1
		lpj=LOOPS_PER_JIFFY
#ifdef CONFIG_SECURE_BOOT
		dm-mod.create=\\\\""rootfs,,,ro, 0 ${num_sectors} verity 1
		"/dev/mtdblock${rootfs_mtdid}" "/dev/mtdblock${rootfs_mtdid}"
		${data_block_size} ${hash_block_size} ${data_blocks}
		${hash_offset_block} ${hash_algo} ${roothash} ${salt}"\\\\"
#endif
		loglevel=${loglevel} wdt_log=${wdt_log};
	bootm ${kernel_memaddr};
	setexpr bootretry ${bootretry} - 1;
	if test ${bootretry} != 0; then run norboot; fi;
	bootm ${kernel_memaddr};
#ifdef CONFIG_SECURE_BOOT
	echo invalid image;
	loop 0 4
#endif

hardware_id=TB008_NOR
