/* SPDX-License-Identifier: GPL-2.0+ */
/*
 * Environment for the dual-slot A/B eMMC boot flow.
 *
 * Copyright (C) 2026 Augentix Inc.
 */

initrd_high=0xffffffff
bootcounter=0
sysupd_type=dual
factory_reset=0
slot_a_active=1
slot_a_bootable=1
slot_a_successful=0
slot_b_active=0
slot_b_bootable=1
slot_b_successful=0

ethaddr=02:00:00:00:00:00
wifiaddr=02:00:00:00:00:00

kernel_memaddr=0x01000000
kernel_size=0x00600000
kernel_lba_a=0xC00
kernel_lba_b=0x5C00
kernel_blk_cnt=0x5000
rootfs_a=/dev/mmcblk0p5
rootfs_b=/dev/mmcblk0p6

loglevel=6
wdt_log=0
bootargs=
ext4_resized=0
envsaved=0
bootretry=3
prod_config=2

#ifdef CONFIG_AUGENTIX_FASTBOOT
camera_fps=CONFIG_AUGENTIX_CAMERA_FPS
#ifdef CONFIG_AUGENTIX_LIGHT_SRC_HW
lux_src=hw
#else
lux_src=sw
#endif
led_on_thre=100
led_on_offset=9
early_ae_drop_num=0
early_vb_size=CONFIG_AUGENTIX_EARLY_VB_SIZE
early_vb_path0_size=CONFIG_AUGENTIX_EARLY_VB_PATH0_SIZE
early_vb_path1_size=CONFIG_AUGENTIX_EARLY_VB_PATH1_SIZE
early_vb_path0_strategy=0
early_vb_path1_strategy=0
early_vb_path0_keep_num=2
early_vb_path1_keep_num=2
path0_width=CONFIG_AUGENTIX_EARLY_VIDEO_PATH0_WIDTH
path0_height=CONFIG_AUGENTIX_EARLY_VIDEO_PATH0_HEIGHT
path1_width=CONFIG_AUGENTIX_EARLY_VIDEO_PATH1_WIDTH
path1_height=CONFIG_AUGENTIX_EARLY_VIDEO_PATH1_HEIGHT
uboot_capture_duration=550
uboot_drop_num=2
#ifdef CONFIG_EARLYAUDIO
early_audio_interface=0
early_audio_channels=1
early_audio_rate=8000
early_audio_format=0
early_audio_analog_gain=0
#endif
#endif

set_boot_slot_a=
	setenv kernel_lba ${kernel_lba_a};
	setenv rootfs ${rootfs_a};

set_boot_slot_b=
	setenv kernel_lba ${kernel_lba_b};
	setenv rootfs ${rootfs_b};

set_fallback=
	if test ${slot_b_active} = 1; then
		if test ${slot_a_bootable} = 1; then
			setenv slot_a_active 1;
			setenv slot_b_active 0;
		fi;
	else
		if test ${slot_b_bootable} = 1; then
			setenv slot_b_active 1;
			setenv slot_a_active 0;
		fi;
	fi;
	setenv bootcounter 0;

set_slotargs=
	if test ${slot_b_active} = 1; then
		run set_boot_slot_b;
	else
		run set_boot_slot_a;
	fi;

update_bootenv=
	if test ${bootcounter} > 2; then
		echo Switch boot slot...;
		run set_fallback;
	fi;
	if test ${slot_b_active} = 1; then
		if test ${slot_b_successful} != 1; then
			setexpr bootcounter ${bootcounter} + 1;
			saveenv;
		fi;
	else
		if test ${slot_a_successful} != 1; then
			setexpr bootcounter ${bootcounter} + 1;
			saveenv;
		fi;
	fi;

default_boot=
	if test ${envsaved} = 0; then setenv envsaved 1; saveenv; fi;
	run update_bootenv;
	run set_slotargs;
	run emmc_boot

emmc_boot=
	mmc dev 0;
	mmc read ${kernel_memaddr} ${kernel_lba} ${kernel_blk_cnt};
#ifdef CONFIG_SECURE_BOOT
	source ${kernel_memaddr}:script-1;
#endif
	setenv bootargs
		console=ttyAS0,CONFIG_BAUDRATE
		root=${rootfs} rootwait rw prod_config=${prod_config}
		clk_ignore_unused ethaddr=${ethaddr} no_console_suspend=1
		lpj=LOOPS_PER_JIFFY
#ifdef CONFIG_AUGENTIX_FASTBOOT
		early_vb_memaddr=${early_vb_memaddr}
		early_vb_size=${early_vb_size}
		early_vb_path0_strategy=${early_vb_path0_strategy}
		early_vb_path1_strategy=${early_vb_path1_strategy}
#endif
#ifdef CONFIG_EARLYAUDIO
		early_audio_buf_addr=${early_audio_buf_addr}
		early_audio_buf_kb=${early_audio_buf_kb}
#endif
		loglevel=${loglevel} wdt_log=${wdt_log};
	bootm ${kernel_memaddr};
	setexpr bootretry ${bootretry} - 1;
	if test ${bootretry} != 0; then run emmc_boot; fi;
	echo FATAL: eMMC boot failed. Resetting...;
	reset;

hardware_id=TB013_EMMC
