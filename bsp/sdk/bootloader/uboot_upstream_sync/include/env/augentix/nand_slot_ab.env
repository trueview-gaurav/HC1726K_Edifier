/* SPDX-License-Identifier: GPL-2.0+ */
/*
 * Copyright (C) 2026 Augentix Inc.
 *
 * Dual-slot A/B SPI-NAND boot flow.
 * SECURE_BOOT selects squashfs over ubiblock with dm-verity.
 */

initrd_high=0xffffffff
ethaddr=02:00:00:00:00:00
wifiaddr=02:00:00:00:00:00
kernel_memaddr=CONFIG_SYS_LOAD_ADDR
kernel_size=CONFIG_AUGENTIX_KERNEL_MAX_SIZE
kernel_0_flashaddr=CONFIG_KERNEL_OFFSET
kernel_1_flashaddr=CONFIG_AUGENTIX_KERNEL_1_OFFSET
rootfs_0_mtdid=CONFIG_AUGENTIX_ROOTFS_MTD_ID
rootfs_1_mtdid=CONFIG_AUGENTIX_ROOTFS_1_MTD_ID
rootfs_mtdid=
usrdatafs_mtdid=7
califs_mtdid=8

bootcounter=0
sysupd_type=dual
factory_reset=0
slot_a_active=1
slot_a_bootable=1
slot_a_successful=0
slot_b_active=0
slot_b_bootable=1
slot_b_successful=0
envsaved=0

loglevel=6
wdt_log=0

#ifdef CONFIG_AUGENTIX_FASTBOOT
camera_fps=CONFIG_AUGENTIX_CAMERA_FPS
#ifdef CONFIG_AUGENTIX_LIGHT_SRC_HW
lux_src=hw
#else
lux_src=sw
#endif
led_on_thre=100
led_on_offset=9
early_ae_drop_num=0
early_vb_size=CONFIG_AUGENTIX_EARLY_VB_SIZE
early_vb_path0_size=CONFIG_AUGENTIX_EARLY_VB_PATH0_SIZE
early_vb_path1_size=CONFIG_AUGENTIX_EARLY_VB_PATH1_SIZE
early_vb_path0_strategy=0
early_vb_path1_strategy=0
early_vb_path0_keep_num=2
early_vb_path1_keep_num=2
path0_width=CONFIG_AUGENTIX_EARLY_VIDEO_PATH0_WIDTH
path0_height=CONFIG_AUGENTIX_EARLY_VIDEO_PATH0_HEIGHT
path1_width=CONFIG_AUGENTIX_EARLY_VIDEO_PATH1_WIDTH
path1_height=CONFIG_AUGENTIX_EARLY_VIDEO_PATH1_HEIGHT
uboot_capture_duration=550
uboot_drop_num=2
#ifdef CONFIG_EARLYAUDIO
early_audio_interface=0
early_audio_channels=1
early_audio_rate=8000
early_audio_format=0
early_audio_analog_gain=0
#endif
#endif

set_boot_slot_a=
	echo Boot from Slot A;
	setenv kernel_flashaddr ${kernel_0_flashaddr};
	setenv rootfs_mtdid ${rootfs_0_mtdid};

set_boot_slot_b=
	echo Boot from Slot B;
	setenv kernel_flashaddr ${kernel_1_flashaddr};
	setenv rootfs_mtdid ${rootfs_1_mtdid};

set_slotargs=
	if test ${slot_b_active} = 1; then
		run set_boot_slot_b;
	else
		run set_boot_slot_a;
	fi;

set_fallback=
	if test ${slot_b_active} = 1; then
		if test ${slot_a_bootable} = 1; then
			setenv slot_a_active 1;
			setenv slot_b_active 0;
		fi;
	else
		if test ${slot_b_bootable} = 1; then
			setenv slot_b_active 1;
			setenv slot_a_active 0;
		fi;
	fi;
	setenv bootcounter 0;

update_bootenv=
	if test ${bootcounter} > 2; then
		echo Switch boot mode...;
		run set_fallback;
	fi;
	if test ${slot_b_active} = 1; then
		if test ${slot_b_successful} != 1; then
			setexpr bootcounter ${bootcounter} + 1;
			saveenv;
		fi;
	else
		if test ${slot_a_successful} != 1; then
			setexpr bootcounter ${bootcounter} + 1;
			saveenv;
		fi;
	fi;

default_boot=
	if test ${envsaved} = 0; then setenv envsaved 1; saveenv; fi;
	run update_bootenv;
	run set_slotargs;
#ifdef CONFIG_ROOTFS_UBIFS
	setenv nandroot ubi.mtd=${rootfs_mtdid} root=ubi0:rootfs
		rootfstype=ubifs ro rootwait;
#elif defined(CONFIG_SECURE_BOOT)
	setenv nandroot ubi.mtd=${rootfs_mtdid} ubi.block=0,0 root=/dev/dm-0
		rootfstype=squashfs ro rootwait;
#else
	setenv nandroot ubi.mtd=${rootfs_mtdid} ubi.block=0,0 root=/dev/ubiblock0_0
		rootfstype=squashfs ro rootwait;
#endif
	run nandboot

load_kernel=
	mtd read spi-nand0 ${kernel_memaddr} ${kernel_flashaddr} 0x1000;
	if itest.l *${kernel_memaddr} == 56190527; then
		setexpr hdrszp ${kernel_memaddr} + 0xc;
		setexpr.l imgsz *${hdrszp};
		setexpr b0 ${imgsz} % 0x100; setexpr b0 ${b0} * 0x1000000;
		setexpr b1 ${imgsz} / 0x100; setexpr b1 ${b1} % 0x100;
		setexpr b1 ${b1} * 0x10000;
		setexpr b2 ${imgsz} / 0x10000; setexpr b2 ${b2} % 0x100;
		setexpr b2 ${b2} * 0x100;
		setexpr b3 ${imgsz} / 0x1000000; setexpr b3 ${b3} % 0x100;
		setexpr imgsz ${b0} + ${b1}; setexpr imgsz ${imgsz} + ${b2};
		setexpr imgsz ${imgsz} + ${b3}; setexpr imgsz ${imgsz} + 0x40;
		if itest ${imgsz} <= ${kernel_size}; then
			mtd read spi-nand0 ${kernel_memaddr} ${kernel_flashaddr} ${imgsz};
		else
			mtd read spi-nand0 ${kernel_memaddr} ${kernel_flashaddr} ${kernel_size};
		fi;
	else
		mtd read spi-nand0 ${kernel_memaddr} ${kernel_flashaddr} ${kernel_size};
	fi;

nandboot=
	run load_kernel;
#ifdef CONFIG_SECURE_BOOT
	source ${kernel_memaddr}:script-1;
#endif
	setenv bootargs ${nandroot} ${mtdparts}
		console=ttyAS0,CONFIG_BAUDRATE clk_ignore_unused
		ethaddr=${ethaddr} no_console_suspend=1
		lpj=LOOPS_PER_JIFFY
		ubi.mtd=${usrdatafs_mtdid} ubi.mtd=${califs_mtdid}
#ifdef CONFIG_SECURE_BOOT
		dm-mod.create=\\\\""rootfs,,,ro, 0 ${num_sectors} verity 1
		/dev/ubiblock0_0 /dev/ubiblock0_0
		${data_block_size} ${hash_block_size} ${data_blocks}
		${hash_offset_block} ${hash_algo} ${roothash} ${salt}"\\\\"
#endif
#ifdef CONFIG_AUGENTIX_FASTBOOT
		early_vb_memaddr=${early_vb_memaddr}
		early_vb_size=${early_vb_size}
		early_vb_path0_strategy=${early_vb_path0_strategy}
		early_vb_path1_strategy=${early_vb_path1_strategy}
#endif
#ifdef CONFIG_EARLYAUDIO
		early_audio_buf_addr=${early_audio_buf_addr}
		early_audio_buf_kb=${early_audio_buf_kb}
#endif
		loglevel=${loglevel} wdt_log=${wdt_log};
	bootm ${kernel_memaddr};
#ifdef CONFIG_SECURE_BOOT
	echo invalid image;
	loop 0 4
#endif

hardware_id=Augentix reference product
