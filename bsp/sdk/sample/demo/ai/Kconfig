menu "ai"

config LIBEAIF
	bool "libeaif"
	select LIBINF
	default y

if LIBEAIF
source ai/libeaif/Kconfig
endif

config LIBINF
	bool "libinf"
	default y

if LIBINF
source ai/libinf/Kconfig
endif

config SAMPLE_DEMO_VFTR_DUMP
	bool "vftr_dump"
	default y
	select LIBEAIF
	select LIBINF
	help
		A debugging utility for IVA applications.

config SAMPLE_DEMO_VFTR_DUMP_SUPPORT_SEI
	bool "Send inference result through RTSP"
	default y
	depends on SAMPLE_DEMO_VFTR_DUMP

