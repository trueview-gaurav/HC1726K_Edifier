config SAMPLE_DEMO_SD_DEMO
	bool "sd_demo"
	default n
	help
		Sample program to demonstrate how to use Sound Detection.

config SAMPLE_DEMO_SD_DEMO_REMOTE_CORE
	bool "sd_demo use remote core"
	depends on SAMPLE_DEMO_SD_DEMO
	default n

config SAMPLE_DEMO_SD_DEMO_TFLITE_OPTIM
	bool "sd_demo: use optimized (slim) TFLite engine"
	depends on SAMPLE_DEMO_SD_DEMO && !SAMPLE_DEMO_SD_DEMO_REMOTE_CORE
	default y
	help
		Link libaftr_cd (the CD v2.0 / YAM Net backend) against the
		optimized libtensorflow-lite-optim engine (~853KB deployed).
		Unset to fall back to the full libtensorflow-lite (~2.8MB) if a
		future model needs an op the slim engine strips out.
		The RTOS remote-core variant uses SVM and ignores this option.

