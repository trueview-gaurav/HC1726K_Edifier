{
	"$schema": "http://json-schema.org/draft-06/schema#",
	"type": "object",
	"title": "AGTX_DIP_TE_CONF_S",
	"comments": [
		"=================================",
		"== Tone enhancement parameters ==",
		"=================================",
		"NOTE: WDR mode only valid at single sensor",
		"ALSO SEE: MPI_setTeAttr"
	],
	"properties": {
		"video_dev_idx": {
			"ui_type": "number",
			"type": "integer",
			"default": 0,
			"minimum": 0,
			"maximum": 0
		},
		"mode": {
			"comments": "Operation mode, 0: normal, 3:adaptive",
			"ui_type": "enum",
			"type": "string",
			"title": "AGTX_TE_MODE_E",
			"enum": ["NORMAL","WDR(deprecated)","WDR_AUTO(deprecated)","ADAPTIVE"],
			"default": "NORMAL"
		},
		"normal_ctl": {
			"ini_name": "te_normal.curve",
			"comments": "Normal mode",
			"ui_type": "curve",
			"type": "array",
			"minItems": 60,
			"maxItems": 60,
			"itemKeys": [
				0, 64, 128, 192, 256, 320, 384, 448, 512, 640, 768, 896, 1024, 1152, 1280,
				1408, 1536, 1664, 1792, 1920, 2048, 2176, 2304, 2432, 2560, 2816, 3072, 3328,
				3584, 3840, 4096, 4352, 4608, 4864, 5120, 5376, 5632, 5888, 6144, 6400, 6656,
				7168, 7680, 8192, 8704, 9216, 9728, 10240, 10752, 11264, 11776, 12288, 12800,
				13312, 13824, 14336, 14848, 15360, 15872, 16384
			],
			"items": {
				"type": "integer",
				"default": 256,
				"minimum": 0,
				"maximum": 16384
			},
			"defaultItems": [
				0, 64, 128, 192, 256, 320, 384, 448, 512, 640, 768, 896, 1024, 1152, 1280,
				1408, 1536, 1664, 1792, 1920, 2048, 2176, 2304, 2432, 2560, 2816, 3072, 3328,
				3584, 3840, 4096, 4352, 4608, 4864, 5120, 5376, 5632, 5888, 6144, 6400, 6656,
				7168, 7680, 8192, 8704, 9216, 9728, 10240, 10752, 11264, 11776, 12288, 12800,
				13312, 13824, 14336, 14848, 15360, 15872, 16384
			]
		},
		"adapt_ctl": {
			"type": "object",
			"title": "AGTX_DIP_TE_ADAPT_S",
			"ini_name": "te_adapt",
			"comments": "Adaptive mode",
			"properties": {
				"dark_enhance": {
					"ui_type": "table",
					"type": "array",
					"minItems": 16,
					"maxItems": 16,
					"items": {
						"type": "integer",
						"default": 8,
						"minimum": 0,
						"maximum": 31
					}
				},
				"te_adapt_based_type": {
					"comments": "adapt based type, 0: TE_ADAPT_NL_BASED , 1: TE_ADAPT_INTTIME_BASED, 2: TE_ADAPT_EV_BASED, 3: TE_ADAPT_BASED_TYPE_RSV",
					"ui_type": "enum",
					"type": "string",
					"title": "AGTX_TE_BASED_TYPE_E",
					"enum": ["TE_ADAPT_NL_BASED","TE_ADAPT_INTTIME_BASED","TE_ADAPT_EV_BASED","TE_ADAPT_BASED_TYPE_RSV"],
					"default": "TE_ADAPT_NL_BASED"
				},
				"str_auto": {
					"ui_type": "table",
					"type": "array",
					"minItems": 16,
					"maxItems": 16,
					"items": {
						"type": "integer",
						"default": 16,
						"minimum": 0,
						"maximum": 1024
					}
				},
				"speed": {
					"comments": "Speed of change of curve",
					"ui_type": "number",
					"type": "integer",
					"default": 102,
					"minimum": 0,
					"maximum": 255
				},
				"white_th": {
					"ui_type": "table",
					"type": "array",
					"minItems": 16,
					"maxItems": 16,
					"items": {
						"type": "integer",
						"default": 15040,
						"minimum": 0,
						"maximum": 16384
					}
				},
				"black_th": {
					"ui_type": "table",
					"type": "array",
					"minItems": 16,
					"maxItems": 16,
					"items": {
						"type": "integer",
						"default": 512,
						"minimum": 0,
						"maximum": 16384
					}
				},
				"max_str_prec_sel": {
					"comments": "max str's precision control",
					"ui_type": "number",
					"type": "integer",
					"default": 0,
					"minimum": 0,
					"maximum": 1
				},
				"max_str": {
					"ui_type": "table",
					"type": "array",
					"minItems": 16,
					"maxItems": 16,
					"items": {
						"type": "integer",
						"default": 7,
						"minimum": 0,
						"maximum": 1024
					}
				},
				"dark_protect_smooth": {
					"ui_type": "table",
					"type": "array",
					"minItems": 16,
					"maxItems": 16,
					"items": {
						"type": "integer",
						"default": 0,
						"minimum": 0,
						"maximum": 8
					}
				},
				"dark_protect_str": {
					"ui_type": "table",
					"type": "array",
					"minItems": 16,
					"maxItems": 16,
					"items": {
						"type": "integer",
						"default": 0,
						"minimum": 0,
						"maximum": 64
					}
				},
				"dark_enhance_th": {
					"ui_type": "table",
					"type": "array",
					"minItems": 16,
					"maxItems": 16,
					"items": {
						"type": "integer",
						"default": 2048,
						"minimum": 0,
						"maximum": 16384
					}
				}
			}
		}
	}
}