{
	"$schema": "http://json-schema.org/draft-06/schema#",
	"type": "object",
	"title": "AGTX_DIP_FCS_CONF_S",
	"comments": [
		"#========================================#",
		"#== False color suppression parameters ==#",
		"#========================================#",
		"# ALSO SEE: MPI_setFcsAttr"
	],
	"properties": {
		"video_dev_idx": {
			"ui_type": "number",
			"ui_access_right": "read_write",
			"type": "integer",
			"default": 0,
			"minimum": 0,
			"maximum": 0
		},
		"mode": {
			"comments": "Operation mode, 0 for auto, 2 for manual",
			"ui_type": "enum",
			"ui_access_right": "read_write",
			"type": "integer",
			"enum": [0, 2],
			"default": 0
		},
		"auto_strength_list": {
			"ini_name": "fcs_auto.strength",
			"ui_type": "table",
			"ui_access_right": "read_write",
			"type": "array",
			"maxItems": 16,
			"minItems": 16,
			"items": {
				"type": "integer",
				"default": 0,
				"minimum": 0,
				"maximum": 255
			}
		},
		"manual_strength": {
			"ini_name": "fcs_manual.strength",
			"comments": "strength of false color suppression (0~255)",
			"ui_type": "number",
			"ui_access_right": "read_write",
			"type": "integer",
			"default": 0,
			"minimum": 0,
			"maximum": 255
		}
	}
}
