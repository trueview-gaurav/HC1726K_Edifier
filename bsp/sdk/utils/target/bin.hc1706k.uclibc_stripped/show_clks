#!/bin/sh

clk_data="/tmp/clk_data"
:> "$clk_data"
# cken
devmem 0x80010010 >> "$clk_data"
# get cksel
devmem 0x80010014 >> "$clk_data"
devmem 0x80010018 >> "$clk_data"
devmem 0x8001001C >> "$clk_data"
devmem 0x80010020 >> "$clk_data"
# get div_sel
devmem 0x80010028 >> "$clk_data"
devmem 0x8001002C >> "$clk_data"
devmem 0x80010030 >> "$clk_data"
devmem 0x80010034 >> "$clk_data"

get_clks /dev/mpll /dev/spll "$clk_data"

rm "$clk_data"
