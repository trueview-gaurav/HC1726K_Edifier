menu "Debug Utils"
	depends on OPTEE

config INSECURE
	bool

config DISABLE_SECURE_STORAGE_NV_COUNTER
	bool "Disable NV Counter for REE FS Secure Storage"
	select INSECURE
	help
	   Disables the use of the non-volatile counter in secure storage. 
           This is intended to simplify development when frequent NV counter 
           updates would otherwise make testing difficult.

           WARNING: Enabling this config removes anti-rollback protection, 
           weakening system security, and MUST NOT be enabled in production.

config REE_FS_ALLOW_RESET
	bool "Allow REE FS Secure Storage Reset"
	select INSECURE
	help
	   Allows the entire secure storage in the REE FS to be deleted without
	   causing anti-rollback errors. 
           This is intended for testing purposes only, for example by removing 
           /usrdata/tee/dirf.db or the whole secure storage path.

           WARNING: Enabling this in a release build will break rollback protection 
           for TA and the entire REE FS secure storage, and MUST NOT be enabled 
           in production.

endmenu # "Debug Utils"
