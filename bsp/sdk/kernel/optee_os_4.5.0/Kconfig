	bool "FAULT_MITIGATION"
	default n
	help
	  Enables best effort mitigations against fault injected when the hardware is tampered with.
	  Details in lib/libutils/ext/include/fault_mitigation.h

config PREALLOC_RPC_CACHE
	bool "PREALLOC_RPC_CACHE"
	default n
	help
	  When enabled, makes core to preallocate shared memory for each secure thread.
	  When disabled, RPC shared memory is released once the secure thread has completed is execution.

endmenu # "Kernel Setting"

