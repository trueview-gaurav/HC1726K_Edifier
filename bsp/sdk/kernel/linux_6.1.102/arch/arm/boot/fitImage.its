/dts-v1/;
/ {
	description = "fitImage";
	#address-cells = <1>;
	images {
		kernel-1 {
			description = "Linux kernel";
			data = /incbin/("./zImage.bin");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x010000BC>;
			entry = <0x010000BC>;
			signature-1 {
				algo = "sha256,rsa2048";
				key-name-hint = "key3";
			};
		};
		script-1 {
			description = "U-boot environment script";
				data = /incbin/("./verity_script");
				type = "script";
				compression = "none";
				signature-1 {
					algo = "sha256,rsa2048";
					key-name-hint = "key3";
				};
		};
	};
	configurations {
		default = "conf-1";
		conf-1 {
			kernel = "kernel-1";
		};
	};
};
