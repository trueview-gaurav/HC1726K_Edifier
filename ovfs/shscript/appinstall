sdcard_format_respawn()
{
        local LastSDExist=0;
        local CurSDExist=0;
        
        devmem 0x10011138 32 0xfff
        devmem 0x10011134 32 0xaaa
        
        mount_mmc
        
        if [ -b /dev/mmcblk0 ] ; then
                let LastSDExist=1;
        fi
        
        sleep 20;

        while true; 
        do
        {
                {
                        if [ -b /dev/mmcblk0 ] ; then
                                let CurSDExist=1;
                        else
                                let CurSDExist=0;
                        fi
					
                        echo "LastSDExist=$LastSDExist,CurSDExist=$CurSDExist";
					
                        if [ $LastSDExist -ne $CurSDExist ] ; then
                                if [ $CurSDExist -eq 1 ] ; then
                                        echo 3 > /proc/sys/vm/drop_caches
                                        umount /tmp/mmc/mmc1; rm -rf /tmp/mmc/mmc1;
                                        mount_mmc
                                else
                                        killall ovfs_record
                                        killall ovfs_eventlog
                                        uritool put /webserver/devicestatus {\"SDCardStatus\":-1}
                                fi
                                LastSDExist=$CurSDExist;
                        elif [ $CurSDExist -eq 1 ] ; then
                                proc_name="/root/bin/ovfs_record";
                                pidof ${proc_name##*/} > /dev/null;ret=$?;
                                if [ ${ret} -ne 0 ] ; then
				                        	echo "$(date) Starting up $proc_name ....";
				                        	chmod +x ${proc_name};
				                        	${proc_name} &
                                fi
                                proc_name="/root/bin/ovfs_eventlog";
                                pidof ${proc_name##*/} > /dev/null;ret=$?;
                                if [ ${ret} -ne 0 ] ; then
				                        	echo "$(date) Starting up $proc_name ....";
				                        	chmod +x ${proc_name};
				                        	${proc_name} &
                                fi
                        fi
                }
                sleep 5;
        }
        done
}

check_mediaserver_listen_port()
{
        while true;
        do
                need=0;
                for i in $(netstat -ntple | grep media | awk -F ' ' '{print $2}');
                do
#                        echo $i;
                        if [ $i -gt 3 ];
                        then
                                echo "listen queue > 3 , need strace";
                                need=1;
                        fi;
                done;
                if [ $need == 1 ];
                then
                        pkill mediaserver;
                fi
                sleep 10;
        done;

}

guard_process()
{
	local proc_name=$1
	local param1=$2
	local param2=$3
	local param3=$4

	local index=0
	local count=20

	while [ $index -lt $count ] ; do
		pidof ${proc_name##*/} > /dev/null;ret=$?;
		if [ ${ret} -ne 0 ] ; then
			echo "name=$proc_name parm1=$param1 parm2=$param2 param3=$param3"
			echo "$(date) Starting up $proc_name .... $index/$count";
			${proc_name} $param1 $param2 $param3 ; ret=$?;

			echo "$(date) $proc_name proc exit=$ret ";
			let index++;
			sleep 3;
			echo 3 > /proc/sys/vm/drop_caches;
		else
			sleep 3;
			echo 3 > /proc/sys/vm/drop_caches;
		fi
	done
	if [ $index -eq $count ] ; then
		echo "$(date) $proc_name starup fail. need reboot";
		reboot;
	fi
}
