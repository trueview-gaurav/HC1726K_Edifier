	macaddr=$(echo $(grep "\"MacAddr\"" "${fileName}") | sed -e "s/^.*\"MacAddr\":[ \t]*\"//g" -e "s/\",\{0,1\}$//g")	
	fi 

	if [ -z $ipaddr ] ; then                                                                                                                  
