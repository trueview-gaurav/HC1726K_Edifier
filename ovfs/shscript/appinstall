guard_phy()
{
	echo "start phy guard"

	sleep 60;

	local nullcnt=0;
	local resetcnt=360;
	while true ; do
		str=`cat /proc/net/arp | grep eth0 | tr -d '\n'`
		ip=${str%% *}
		if [ -z "$ip" ] ; then
			sleep 10;
			let nullcnt++;
			if [ $nullcnt -gt $resetcnt ] ; then
				echo "$nullcnt gt $resetcnt";
				ifconfig eth0 down;
				sleep 1;
				ifconfig eth0 up;
				nullcnt=0;
			fi
		else
			nullcnt=0;
			ret=1;
			while [ -n "$ip" ] ; do
				result=`arping -D -f -w 3 -I eth0 $ip | grep Unicast`
				if [ -n "$result" ] ; then
					echo "arping $ip ok";
					ret=0;
					break;
				else
					echo "arping $ip failed";
				fi
				str=${str#*eth0};
				ip=${str%% *};
			done
			if [ ${ret} -ne 0 ] ; then
				ifconfig eth0 down;
				sleep 1;
				ifconfig eth0 up;
				sleep 180;
			fi
		fi
		sleep 3;
	done;
}
start_module()
{
	echo 8388608 > /sys/block/zram0/disksize;
	mkswap /dev/zram0;
	swapon /dev/zram0;
	echo 100 > /proc/sys/vm/swappiness ;
	
	echo 2 | tee /proc/sys/kernel/randomize_va_space;

	sysctl -w net.ipv4.tcp_tw_recycle=0;
	sysctl -w vm.drop_caches=3;
	date;free;
	syslogd -O /tmp/syslog.log -s 64 -b 8 -l 6;
	cd /root/
	echo "sysinit..."
	sysinit&

	guard_phy&

	echo 0 > /proc/sys/net/ipv4/neigh/default/gc_thresh1;

	echo "Start core..."
	ovfs_core&

	echo "Start network..."
	ovfs_network&
	sleep 2;

	echo "Start boardsystem..."
	ovfs_boardsystem&
	sleep 5;

	echo "Start webserver..."
	ovfs_webserver&
	sleep 1;

	echo "Start webserver..."
	ovfs_mediaserver&
	sleep 1;

	echo "update..."
	if [ -f /root/bin/update ] ; then
		pkill update
		cp /root/bin/update /dev/;
		cd /dev;./update&
		cd /;
	fi
	sleep 5;

	sdcard_format_respawn &
}

