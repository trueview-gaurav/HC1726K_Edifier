	ipaddr=
	macaddr=
	fileName=/usr/etc/cfgfiles/NetWork.json;
	if [ ! -f ${fileName} ] ; then
	fileName=/update/res/default/NetWork.json;
	fi
	if [ -f ${fileName} ] ; then
#	ipaddr=$(echo $(grep "\"IpAddrV4\"" "${fileName}") | sed -e "s/\"//g" -e "s/IpAddrV4://g" | cut -d ',' -f 1)                 
#	ipmask=$(echo $(grep "\"IpMaskV4\"" "${fileName}") | sed -e "s/\"//g" -e "s/IpMaskV4://g" | cut -d ',' -f 1)         
#	gateway=$(echo $(grep "\"GatewayV4\"" "${fileName}") | sed -e "s/\"//g" -e "s/GatewayV4://g" | cut -d ',' -f 1)
