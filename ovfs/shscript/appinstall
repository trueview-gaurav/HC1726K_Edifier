mount_part()
{
	fsType=$1;
	partIndex=$2;
	mountPath=$3;
#	hexdump /dev/mtdblock${partIndex} -n 4 -C | grep -q "UBI#"; 
#	if [ $? -eq 0 ] ; then
	if [ "${fsType}" == "ubifs" ] ; then
	partName=$(cat /proc/mtd | grep "mtd${partIndex}" | cut -d ' ' -f 4)
	avlSize=$((((0x$(cat /proc/mtd | grep "mtd${partIndex}" | cut -d ' ' -f 2)/128/1024)-24)*(128-2*2)*1024))
	ubiattach /dev/ubi_ctrl -m ${partIndex} -d ${partIndex};
	[ -e /dev/ubi${partIndex}_0 ] || ubimkvol /dev/ubi${partIndex} -N ${partName} -s ${avlSize};
	mount -t ubifs -o sync /dev/ubi${partIndex}_0 ${mountPath} || \
	mount -t yaffs2  /dev/mtdblock${partIndex} ${mountPath};
	elif [ "${fsType}" == "jffs2" ] ; then
	mount -t jffs2 -o sync /dev/mtdblock${partIndex} ${mountPath};
	else
	mount -t yaffs2 -o sync /dev/mtdblock${partIndex} ${mountPath};
	fi
}

mount_mtd()
{
if [ ! -d /usr/etc ] ; then 
	mkdir /usr/etc -p
fi

if [ $mtdtype == "sfc_nand" ] ; then

	## mount config
	config_index=`cat /proc/mtd |grep -e "config" | sed -e "s/:.*//g" | cut -c 4-`;
	[ -d /usr/etc ] || mkdir -p /usr/etc;
	#mount_part yaffs2 ${config_index} /usr/etc
	mount_part ubifs ${config_index} /usr/etc
	
	### mount smart
	smart_index=`cat /proc/mtd |grep -e "smart" | sed -e "s/:.*//g" | cut -c 4-`;
	[ -d /smart ] || mkdir -p /smart;
	mount_part ubifs ${smart_index} /smart
	
else
	mount -t jffs2 mtd:config /usr/etc
fi
}

untar_pack()
{
	echo "untar packet..."
	for tarfile in /update/*.tar.xz ; do
		filename=$(basename $tarfile | sed -e "s/.tar.xz//");
		cp $tarfile /var/untar;
		xz -d /var/untar/$filename.tar.xz;
		tar -xvf /var/untar/$filename.tar -C /var/untar;
		rm /var/untar/$filename.tar;
		ln -s /var/untar/$filename /root/$filename
	done
	
	mkdir -p /tmp/nginx/logs && ln -s /tmp/nginx/logs /root/nginx/logs
	echo "untar packet...ok"
}

