mount_mmc()
{
	local index=0;
	
	chmod a+x /root/mount_mmc
	while [ true ] ; do
	if [ -e /dev/mmcblk0 ] ; then
		/root/mount_mmc
		if [ -d /tmp/mmc/mmc1 ] ; then
			ovfs_record&
			ovfs_eventlog&
		fi
		break;
	else
		sleep 3;
			
		let index++;
		if [ $index -eq 3 ] ; then
			if [ -d /tmp/mmc/mmc1 ] ; then 
				ovfs_record&
				ovfs_eventlog&
			fi
			break;
		fi
	fi
	done
}

